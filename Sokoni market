export interface DeliveryQuoteInput {
  countyCode: number;
  method: DeliveryMethod;
  subtotalCents: number;
  freeDeliveryThresholdCents?: number;
}

@Injectable()
export class DeliveryService {
  constructor(private readonly prisma: PrismaService) {}

  quote(input: DeliveryQuoteInput) {
    const county = COUNTIES.find((c) => c.code === input.countyCode);
    if (!county) throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Invalid county' }, HttpStatus.BAD_REQUEST);
    const threshold = input.freeDeliveryThresholdCents ?? 300_000; // KES 3,000 default
    const isFreeDelivery = county.zone === 'NAIROBI_METRO' && input.subtotalCents >= threshold;
    const feeCents = isFreeDelivery ? 0 : calculateDeliveryFee(county.zone, input.method);
    return {
      countyCode: county.code,
      countyName: county.name,
      zone: county.zone,
      method: input.method,
      feeCents,
      etaDays: estimateDelivery(county.zone),
      freeDeliveryApplied: isFreeDelivery,
    };
  }

  async listPickupStations(countyCode?: number) {
    return this.prisma.pickupStation.findMany({
      where: { isActive: true, ...(countyCode ? { countyCode } : {}) },
      orderBy: [{ countyCode: 'asc' }, { name: 'asc' }],
    });
  }
}
