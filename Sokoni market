const RECENT_KEY = 'sokoni-recent-searches';

export default function SearchPage() {
  const search = useSearchParams();
  const q = search.get('q') ?? '';
  const [input, setInput] = useState(q);
  const [recent, setRecent] = useState<string[]>([]);
  const [suggest, setSuggest] = useState<Array<{ text: string; slug: string }>>([]);

  useEffect(() => { setInput(q); }, [q]);
  useEffect(() => {
    if (typeof window === 'undefined') return;
    setRecent(JSON.parse(window.localStorage.getItem(RECENT_KEY) ?? '[]'));
  }, []);
  useEffect(() => {
    if (q.trim().length < 2) { setSuggest([]); return; }
    const t = setTimeout(async () => {
      try {
        const res = await api.get<Array<{ text: string; slug: string }>>(`/search/suggest?q=${encodeURIComponent(q)}`);
        setSuggest(res);
      } catch { /* ignore */ }
    }, 250);
    return () => clearTimeout(t);
  }, [q]);
  useEffect(() => {
    if (!q || q.trim().length < 2) return;
    const next = [q, ...recent.filter((x) => x !== q)].slice(0, 8);
    setRecent(next);
    window.localStorage.setItem(RECENT_KEY, JSON.stringify(next));
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [q]);

  const { data, isLoading } = useQuery({
    queryKey: ['search', q],
    queryFn: async () => {
      const res = await api.get<{ ids: string[]; total: number; page: number; perPage: number }>(`/search?q=${encodeURIComponent(q)}&perPage=24`);
      if (res.ids.length === 0) return { data: [], meta: { total: 0 } };
      const all: ProductListItem[] = [];
      for (const id of res.ids) {
        try { all.push(await api.get<ProductListItem>(`/products/${id}`)); } catch { /* ignore */ }
      }
      return { data: all, meta: { total: res.total } };
    },
    enabled: !!q,
  });

  return (
    <div className="container-tight py-4">
      <form onSubmit={(e) => { e.preventDefault(); window.location.href = `/search?q=${encodeURIComponent(input)}`; }} className="relative mb-4">
        <SearchIcon className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
        <Input value={input} onChange={(e) => setInput(e.target.value)} placeholder="Search products…" className="pl-9" autoFocus />
      </form>

      {suggest.length > 0 && q && (
        <ul className="mb-4 divide-y rounded-md border bg-white">
          {suggest.map((s) => (
            <li key={s.slug}>
              <Link href={`/product/${s.slug}`} className="block px-3 py-2 text-sm hover:bg-muted">{s.text}</Link>
            </li>
          ))}
        </ul>
      )}

      {!q && recent.length > 0 && (
        <section className="mb-6">
          <h2 className="mb-2 text-sm font-semibold text-muted-foreground">Recent searches</h2>
          <div className="flex flex-wrap gap-2">
            {recent.map((r) => (
              <Link key={r} href={`/search?q=${encodeURIComponent(r)}`} className="rounded-full border px-3 py-1 text-sm hover:bg-muted">{r}</Link>
            ))}
          </div>
        </section>
      )}

      {q && (
        <>
          <p className="mb-3 text-sm text-muted-foreground">Results for <span className="font-medium text-foreground">&quot;{q}&quot;</span></p>
          {isLoading && <div className="grid grid-cols-2 gap-3 md:grid-cols-4">{Array.from({ length: 8 }).map((_, i) => <Skeleton key={i} className="aspect-square" />)}</div>}
          {data && data.data.length === 0 && !isLoading && (
            <p className="rounded-md border bg-muted/30 p-8 text-center text-sm text-muted-foreground">No results. Try a different term.</p>
          )}
          <div className="grid grid-cols-2 gap-3 md:grid-cols-4">
            {data?.data.map((p) => <ProductCard key={p.id} product={p} />)}
          </div>
        </>
      )}
    </div>
  );
}
