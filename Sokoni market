    if (!vendor) throw new HttpException({ code: ErrorCode.NOT_FOUND, message: 'Vendor not found' }, HttpStatus.NOT_FOUND);
    if (vendor.status !== VendorStatus.APPROVED) {
      throw new HttpException({ code: ErrorCode.AUTH_FORBIDDEN, message: 'Vendor not approved' }, HttpStatus.FORBIDDEN);
    }
    return vendor;
  }
}
