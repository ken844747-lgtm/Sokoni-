@Injectable()
export class AddressesService {
  constructor(private readonly prisma: PrismaService) {}

  private countyName(code: number): string {
    const c = COUNTIES.find((x) => x.code === code);
    if (!c) throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Invalid county code' }, HttpStatus.BAD_REQUEST);
    return c.name;
  }

  async list(userId: string) {
    return this.prisma.address.findMany({
      where: { userId },
      orderBy: [{ isDefault: 'desc' }, { createdAt: 'desc' }],
    });
  }

  async create(userId: string, dto: CreateAddressDto) {
    const phone = normalizeKenyanPhone(dto.phone);
    if (!phone) throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Invalid phone' }, HttpStatus.BAD_REQUEST);
    const countyName = this.countyName(dto.countyCode);
    return this.prisma.$transaction(async (tx) => {
      if (dto.isDefault) {
        await tx.address.updateMany({ where: { userId, isDefault: true }, data: { isDefault: false } });
      }
      const count = await tx.address.count({ where: { userId } });
      return tx.address.create({
        data: {
          userId,
          label: dto.label,
          fullName: dto.fullName,
          phone,
          countyCode: dto.countyCode,
          countyName,
          town: dto.town,
          line1: dto.line1,
          line2: dto.line2,
          landmark: dto.landmark,
          postalCode: dto.postalCode,
          latitude: dto.latitude,
          longitude: dto.longitude,
          isDefault: dto.isDefault ?? count === 0,
        },
      });
    });
  }

  async update(userId: string, addressId: string, dto: UpdateAddressDto) {
    const existing = await this.prisma.address.findFirst({ where: { id: addressId, userId } });
    if (!existing) throw new HttpException({ code: ErrorCode.NOT_FOUND, message: 'Address not found' }, HttpStatus.NOT_FOUND);
    const data: any = {};
    if (dto.label !== undefined) data.label = dto.label;
    if (dto.fullName !== undefined) data.fullName = dto.fullName;
    if (dto.phone !== undefined) {
      const phone = normalizeKenyanPhone(dto.phone);
      if (!phone) throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Invalid phone' }, HttpStatus.BAD_REQUEST);
      data.phone = phone;
    }
    if (dto.countyCode !== undefined) {
      data.countyCode = dto.countyCode;
      data.countyName = this.countyName(dto.countyCode);
    }
    if (dto.town !== undefined) data.town = dto.town;
    if (dto.line1 !== undefined) data.line1 = dto.line1;
    if (dto.line2 !== undefined) data.line2 = dto.line2;
    if (dto.landmark !== undefined) data.landmark = dto.landmark;
    if (dto.postalCode !== undefined) data.postalCode = dto.postalCode;
    if (dto.latitude !== undefined) data.latitude = dto.latitude;
    if (dto.longitude !== undefined) data.longitude = dto.longitude;
    if (dto.isDefault !== undefined) data.isDefault = dto.isDefault;

    return this.prisma.$transaction(async (tx) => {
      if (dto.isDefault) {
        await tx.address.updateMany({ where: { userId, isDefault: true, NOT: { id: addressId } }, data: { isDefault: false } });
      }
      return tx.address.update({ where: { id: addressId }, data });
    });
  }

  async remove(userId: string, addressId: string) {
    const existing = await this.prisma.address.findFirst({ where: { id: addressId, userId } });
    if (!existing) throw new HttpException({ code: ErrorCode.NOT_FOUND, message: 'Address not found' }, HttpStatus.NOT_FOUND);
    await this.prisma.address.delete({ where: { id: addressId } });
    return { message: 'Deleted' };
  }
}
