@ApiTags('vendor-orders')
@Controller('vendors/mine/orders')
@UseGuards(JwtAuthGuard, RolesGuard)
@Roles(Role.VENDOR)
export class VendorOrdersController {
  constructor(private readonly prisma: PrismaService, private readonly orders: OrdersService) {}

  @Get()
  async list(
    @CurrentUser() user: AuthUser,
    @Query('status') status?: OrderStatus,
    @Query('page') page = '1',
  ) {
    const p = Math.max(1, Number(page));
    const perPage = 25;
    const where: Prisma.OrderWhereInput = {
      items: { some: { vendorId: user.vendorId! } },
      ...(status ? { status } : {}),
    };
    const [rows, total] = await Promise.all([
      this.prisma.order.findMany({
        where,
        include: {
          items: { where: { vendorId: user.vendorId! } },
          user: { select: { fullName: true, phone: true } },
        },
        orderBy: { createdAt: 'desc' },
        skip: (p - 1) * perPage,
        take: perPage,
      }),
      this.prisma.order.count({ where }),
    ]);
    return { data: rows, meta: { page: p, perPage, total, totalPages: Math.max(1, Math.ceil(total / perPage)) } };
  }

  @Patch(':id/status')
  async updateStatus(@CurrentUser() user: AuthUser, @Param('id') id: string, @Body() body: { status: OrderStatus; note?: string }) {
    const order = await this.prisma.order.findUnique({ where: { id }, include: { items: true } });
    if (!order || !order.items.some((i) => i.vendorId === user.vendorId)) throw new Error('Not your order');
    return this.orders.transitionOrder({ orderId: id, to: body.status, actorId: user.id, actorRole: 'VENDOR', note: body.note });
  }
}
import { HttpException, HttpStatus, Injectable, Logger } from '@nestjs/common';
import { ErrorCode, ProductStatus } from '@sokoni/shared';
import slugify from 'slugify';
import { PrismaService } from '../prisma/prisma.service';
import { SearchService } from '../search/search.service';

interface CsvRow {
  name: string; category: string; description: string; brand?: string;
  images: string; priceCents: string; compareAtCents?: string;
  variantSku: string; variantName: string; variantPriceCents: string; quantity: string;
}

export interface BulkResult {
  imported: number;
  errors: Array<{ row: number; message: string }>;
}

@Injectable()
export class BulkProductsService {
  private readonly logger = new Logger(BulkProductsService.name);

  constructor(private readonly prisma: PrismaService, private readonly search: SearchService) {}

  async importCsv(vendorId: string, csvText: string): Promise<BulkResult> {
    const rows = this.parseCsv(csvText);
    if (rows.length === 0) throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'CSV is empty' }, HttpStatus.BAD_REQUEST);
    const categories = await this.prisma.category.findMany({ select: { id: true, slug: true, name: true } });
    const catByName = new Map(categories.map((c) => [c.name.toLowerCase(), c]));
    const catBySlug = new Map(categories.map((c) => [c.slug.toLowerCase(), c]));

    const result: BulkResult = { imported: 0, errors: [] };
    for (let i = 0; i < rows.length; i++) {
      const r = rows[i];
      try {
        const cat = catByName.get(r.category.toLowerCase()) ?? catBySlug.get(r.category.toLowerCase());
        if (!cat) throw new Error(`Unknown category "${r.category}"`);

        const name = r.name?.trim();
        if (!name) throw new Error('name is required');
        const baseSlug = slugify(name, { lower: true, strict: true });
        let slug = baseSlug; let n = 1;
        while (await this.prisma.product.findUnique({ where: { slug } })) slug = `${baseSlug}-${++n}`;

        const images = (r.images ?? '').split('|').map((s) => s.trim()).filter(Boolean);

        await this.prisma.product.create({
          data: {
            vendorId,
            categoryId: cat.id,
            slug,
            name,
            description: r.description || name,
            brand: r.brand,
            images: images as any,
            basePriceCents: Number(r.priceCents),
            compareAtCents: r.compareAtCents ? Number(r.compareAtCents) : null,
            status: ProductStatus.ACTIVE,
            publishedAt: new Date(),
            variants: {
              create: [{
                sku: r.variantSku || `SKU-${slug}`,
                name: r.variantName || 'Standard',
                priceCents: Number(r.variantPriceCents || r.priceCents),
                inventory: { create: { quantity: Number(r.quantity || 0) } },
              }],
            },
          },
        });
        result.imported++;
      } catch (err: any) {
        result.errors.push({ row: i + 2, message: err.message });
      }
    }
    this.search.reindexAll().catch(() => undefined);
    return result;
  }

  private parseCsv(text: string): CsvRow[] {
    const lines = text.replace(/\r\n/g, '\n').split('\n').filter((l) => l.trim().length > 0);
    if (lines.length < 2) return [];
    const headers = this.splitLine(lines[0]).map((h) => h.trim());
    return lines.slice(1).map((line) => {
      const cells = this.splitLine(line);
      const row: any = {};
      headers.forEach((h, i) => { row[h] = cells[i] ?? ''; });
      return row as CsvRow;
    });
  }

  private splitLine(line: string): string[] {
    const out: string[] = [];
    let cur = ''; let q = false;
    for (let i = 0; i < line.length; i++) {
      const ch = line[i];
      if (q) {
        if (ch === '"' && line[i + 1] === '"') { cur += '"'; i++; }
        else if (ch === '"') q = false;
        else cur += ch;
      } else if (ch === '"') q = true;
      else if (ch === ',') { out.push(cur); cur = ''; }
      else cur += ch;
    }
    out.push(cur);
    return out;
  }

  template(): string {
    return [
      'name,category,description,brand,images,priceCents,compareAtCents,variantSku,variantName,variantPriceCents,quantity',
      'Sample Product,Electronics,A great product,Sokoni,https://placehold.co/800,499900,599900,SKU-001,Standard,499900,10',
    ].join('\n');
  }
}
