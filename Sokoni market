import { HttpException, HttpStatus, Injectable } from '@nestjs/common';
import { PaymentProvider, PaymentStatus, RefundStatus } from '@prisma/client';
import { ErrorCode } from '@sokoni/shared';
import { PrismaService } from '../prisma/prisma.service';
import { DarajaClient } from './providers/daraja.client';
import { AuditService } from '../audit/audit.service';
import { NotificationsService } from '../notifications/notifications.service';

@Injectable()
export class RefundsService {
  constructor(
    private readonly prisma: PrismaService,
    private readonly daraja: DarajaClient,
    private readonly audit: AuditService,
    private readonly notifications: NotificationsService,
  ) {}

  async request(userId: string, orderId: string, reason: string) {
    const order = await this.prisma.order.findUnique({ where: { id: orderId } });
    if (!order || order.userId !== userId) throw new HttpException({ code: ErrorCode.ORDER_NOT_FOUND, message: 'Order not found' }, HttpStatus.NOT_FOUND);
    if (!['PAID', 'PROCESSING', 'SHIPPED', 'DELIVERED'].includes(order.status)) {
      throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Refunds only for paid orders' }, HttpStatus.BAD_REQUEST);
    }
    const payment = await this.prisma.payment.findFirst({ where: { orderId, status: PaymentStatus.SUCCESS } });
    if (!payment) throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'No successful payment' }, HttpStatus.BAD_REQUEST);
    return this.prisma.refund.create({
      data: { orderId, paymentId: payment.id, amountCents: order.totalCents, reason, provider: payment.provider, status: RefundStatus.REQUESTED },
    });
  }

  async listAdmin() { return this.prisma.refund.findMany({ orderBy: { createdAt: 'desc' }, include: { order: { select: { orderNumber: true } } }, take: 100 }); }

  async approve(adminId: string, refundId: string) {
    const refund = await this.prisma.refund.findUnique({ where: { id: refundId }, include: { payment: true } });
    if (!refund) throw new HttpException({ code: ErrorCode.NOT_FOUND, message: 'Refund not found' }, HttpStatus.NOT_FOUND);
    if (refund.status !== RefundStatus.REQUESTED) throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Already processed' }, HttpStatus.BAD_REQUEST);
    await this.prisma.refund.update({ where: { id: refundId }, data: { status: RefundStatus.PROCESSING, approvedById: adminId } });
    try {
      // M-Pesa refund via B2C
      if (refund.provider === PaymentProvider.MPESA_STK && refund.payment?.phone) {
        const res = await this.daraja.b2cRefund({ phone: refund.payment.phone, amountCents: refund.amountCents, remarks: `Refund ${refund.orderId}` });
        await this.prisma.refund.update({
          where: { id: refundId },
          data: { status: RefundStatus.SUCCESS, providerRef: (res as any).ConversationID, completedAt: new Date(), rawPayload: res as any },
        });
        await this.prisma.order.update({
          where: { id: refund.orderId },
          data: { status: 'REFUNDED', events: { create: { fromStatus: 'DELIVERED', toStatus: 'REFUNDED', actorId: adminId, actorRole: 'ADMIN', note: 'Refund processed' } } },
        });
      } else {
        await this.prisma.refund.update({ where: { id: refundId }, data: { status: RefundStatus.SUCCESS, completedAt: new Date() } });
      }
      await this.notifications.notify({ userId: (await this.prisma.order.findUnique({ where: { id: refund.orderId } }))!.userId, title: 'Refund processed', body: `Refund of KES ${(refund.amountCents / 100).toFixed(2)} completed.` });
    } catch (err: any) {
      await this.prisma.refund.update({ where: { id: refundId }, data: { status: RefundStatus.FAILED, failureReason: err.message } });
    }
    await this.audit.record({ actorId: adminId, action: 'REFUND_APPROVED', entity: 'Refund', entityId: refundId });
    return this.prisma.refund.findUnique({ where: { id: refundId } });
  }
}
