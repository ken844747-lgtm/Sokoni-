import { HttpException, HttpStatus, Injectable } from '@nestjs/common';
import { ErrorCode } from '@sokoni/shared';
import slugify from 'slugify';
import { PrismaService } from '../prisma/prisma.service';
import { CreateCategoryDto, UpdateCategoryDto } from './dto/category.dto';

export interface CategoryNode {
  id: string;
  parentId: string | null;
  slug: string;
  name: string;
  description: string | null;
  iconKey: string | null;
  imageUrl: string | null;
  position: number;
  isActive: boolean;
  children: CategoryNode[];
  productCount?: number;
}

@Injectable()
export class CategoriesService {
  constructor(private readonly prisma: PrismaService) {}

  async listTree(opts: { onlyActive?: boolean; includeProductCount?: boolean } = {}): Promise<CategoryNode[]> {
    const rows = await this.prisma.category.findMany({
      where: opts.onlyActive ? { isActive: true } : {},
      orderBy: [{ position: 'asc' }, { name: 'asc' }],
    });
    const counts = opts.includeProductCount
      ? await this.prisma.product.groupBy({
          by: ['categoryId'],
          where: { status: 'ACTIVE' },
          _count: { _all: true },
        })
      : [];
    const countMap = new Map(counts.map((c) => [c.categoryId, c._count._all]));

    const byId = new Map<string, CategoryNode>();
    for (const r of rows) {
      byId.set(r.id, {
        id: r.id,
        parentId: r.parentId,
        slug: r.slug,
        name: r.name,
        description: r.description,
        iconKey: r.iconKey,
        imageUrl: r.imageUrl,
        position: r.position,
        isActive: r.isActive,
        children: [],
        productCount: countMap.get(r.id),
      });
    }
    const roots: CategoryNode[] = [];
    for (const node of byId.values()) {
      if (node.parentId && byId.has(node.parentId)) byId.get(node.parentId)!.children.push(node);
      else roots.push(node);
    }
    return roots;
  }

  async findBySlug(slug: string) {
    const cat = await this.prisma.category.findUnique({ where: { slug } });
    if (!cat) throw new HttpException({ code: ErrorCode.NOT_FOUND, message: 'Category not found' }, HttpStatus.NOT_FOUND);
    return cat;
  }

  async create(dto: CreateCategoryDto) {
    const slug = dto.slug ?? slugify(dto.name, { lower: true, strict: true });
    if (dto.parentId) {
      const parent = await this.prisma.category.findUnique({ where: { id: dto.parentId } });
      if (!parent) throw new HttpException({ code: ErrorCode.NOT_FOUND, message: 'Parent category not found' }, HttpStatus.BAD_REQUEST);
    }
    return this.prisma.category.create({
      data: {
        name: dto.name,
        slug,
        parentId: dto.parentId ?? null,
        description: dto.description,
        iconKey: dto.iconKey,
        imageUrl: dto.imageUrl,
        position: dto.position ?? 0,
        isActive: dto.isActive ?? true,
      },
    });
  }

  async update(id: string, dto: UpdateCategoryDto) {
    const existing = await this.prisma.category.findUnique({ where: { id } });
    if (!existing) throw new HttpException({ code: ErrorCode.NOT_FOUND, message: 'Category not found' }, HttpStatus.NOT_FOUND);
    if (dto.parentId === id) throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Category cannot be its own parent' }, HttpStatus.BAD_REQUEST);
    return this.prisma.category.update({
      where: { id },
      data: {
        name: dto.name,
        slug: dto.slug,
        parentId: dto.parentId === undefined ? undefined : dto.parentId,
        description: dto.description,
        iconKey: dto.iconKey,
        imageUrl: dto.imageUrl,
        position: dto.position,
        isActive: dto.isActive,
      },
    });
  }

  async remove(id: string) {
    const productCount = await this.prisma.product.count({ where: { categoryId: id } });
    if (productCount > 0) {
      throw new HttpException(
        { code: ErrorCode.VALIDATION_ERROR, message: `Category has ${productCount} products; reassign first` },
        HttpStatus.BAD_REQUEST,
      );
    }
    const childCount = await this.prisma.category.count({ where: { parentId: id } });
    if (childCount > 0) {
      throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Delete child categories first' }, HttpStatus.BAD_REQUEST);
    }
    await this.prisma.category.delete({ where: { id } });
    return { message: 'Deleted' };
  }
}
