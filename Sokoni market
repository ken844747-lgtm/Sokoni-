/**
 * In-memory store used only in MPESA_MODE=mock.
 * Maps CheckoutRequestID → record so the callback simulation can flip status.
 */
@Injectable()
export class MockDarajaStore {
  private readonly logger = new Logger(MockDarajaStore.name);
  private readonly records = new Map<string, MockStkRecord>();

  stkPush(input: {
    phone: string;
    amountKes: number;
    accountReference: string;
  }): { checkoutRequestId: string; merchantRequestId: string; customerMessage: string } {
    const checkoutRequestId = `ws_CO_MOCK_${randomUUID().replace(/-/g, '').slice(0, 20)}`;
    const merchantRequestId = `MOCK-${randomUUID().replace(/-/g, '').slice(0, 16)}`;
    this.records.set(checkoutRequestId, {
      checkoutRequestId,
      merchantRequestId,
      phone: input.phone,
      amountKes: input.amountKes,
      accountReference: input.accountReference,
      createdAt: Date.now(),
      status: 'PENDING',
    });
    this.logger.log(`[MOCK] STK push → ${input.phone} for KES ${input.amountKes} (${checkoutRequestId})`);
    return {
      checkoutRequestId,
      merchantRequestId,
      customerMessage: 'Success. Request accepted for processing',
    };
  }

  get(checkoutRequestId: string): MockStkRecord | undefined {
    return this.records.get(checkoutRequestId);
  }

  complete(
    checkoutRequestId: string,
    outcome: 'succeed' | 'fail' | 'cancel',
  ): MockStkRecord | undefined {
    const rec = this.records.get(checkoutRequestId);
    if (!rec || rec.status !== 'PENDING') return rec;
    if (outcome === 'succeed') {
      rec.status = 'SUCCESS';
      rec.receipt = `MOCK${Math.random().toString(36).slice(2, 10).toUpperCase()}`;
      rec.resultCode = 0;
      rec.resultDesc = 'The service request is processed successfully.';
    } else if (outcome === 'cancel') {
      rec.status = 'CANCELLED';
      rec.resultCode = 1032;
      rec.resultDesc = 'Request cancelled by user';
    } else {
      rec.status = 'FAILED';
      rec.resultCode = 2001;
      rec.resultDesc = 'The initiator information is invalid.';
    }
    return rec;
  }

  query(checkoutRequestId: string): MockStkRecord | undefined {
    return this.records.get(checkoutRequestId);
  }
}
