export const CART_SID_COOKIE = 'sokoni_sid';

export function getOrCreateCartSid(req: Request, res: Response, secure: boolean): string {
  const existing = (req as any).cookies?.[CART_SID_COOKIE];
  if (typeof existing === 'string' && existing.length > 0) return existing;
  const sid = randomUUID();
  const opts: CookieOptions = { httpOnly: true, secure, sameSite: 'lax', path: '/', maxAge: 30 * 24 * 3600 * 1000 };
  res.cookie(CART_SID_COOKIE, sid, opts);
  return sid;
}
