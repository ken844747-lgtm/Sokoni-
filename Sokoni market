import { MockDarajaStore } from './mock-daraja.client';
import { InitiateResult, PaymentProviderAdapter, RefundResult, VerifyResult } from './payment-provider.interface';

@Injectable()
export class MpesaProvider implements PaymentProviderAdapter {
  readonly name = PaymentProvider.MPESA_STK;
  private readonly logger = new Logger(MpesaProvider.name);
  private readonly mode: 'mock' | 'sandbox' | 'production';

  constructor(
    private readonly daraja: DarajaClient,
    private readonly mock: MockDarajaStore,
    private readonly config: ConfigService,
  ) {
    this.mode = config.get<'mock' | 'sandbox' | 'production'>('MPESA_MODE', 'mock');
  }

  async initiate(opts: {
    orderId: string;
    orderNumber: string;
    amountCents: number;
    phone?: string;
    callbackUrl: string;
  }): Promise<InitiateResult> {
    if (!opts.phone) throw new Error('Phone required for M-Pesa');
    if (this.mode === 'mock') {
      const res = this.mock.stkPush({
        phone: opts.phone,
        amountKes: opts.amountCents / 100,
        accountReference: opts.orderNumber,
      });
      return {
        providerRef: res.checkoutRequestId,
        merchantRef: res.merchantRequestId,
        status: PaymentStatus.PENDING,
        customerMessage: res.customerMessage,
        raw: { mock: true, ...res },
      };
    }

    const res = await this.daraja.stkPush({
      phone: opts.phone,
      amountCents: opts.amountCents,
      accountReference: opts.orderNumber,
      callbackUrl: opts.callbackUrl,
    });
    if (res.ResponseCode !== '0') {
      throw new Error(`STK push rejected: ${res.ResponseDescription}`);
    }
    return {
      providerRef: res.CheckoutRequestID,
      merchantRef: res.MerchantRequestID,
      status: PaymentStatus.PENDING,
      customerMessage: res.CustomerMessage,
      raw: res as unknown as Record<string, unknown>,
    };
  }

  async verify(checkoutRequestId: string): Promise<VerifyResult> {
    if (this.mode === 'mock') {
      const rec = this.mock.query(checkoutRequestId);
      if (!rec) return { status: PaymentStatus.PENDING, raw: {} };
      const statusMap: Record<string, PaymentStatus> = {
        PENDING: PaymentStatus.PENDING,
        SUCCESS: PaymentStatus.SUCCESS,
        FAILED: PaymentStatus.FAILED,
        CANCELLED: PaymentStatus.FAILED,
        EXPIRED: PaymentStatus.EXPIRED,
      };
      return {
        status: statusMap[rec.status] ?? PaymentStatus.PENDING,
        amountCents: rec.amountKes * 100,
        receipt: rec.receipt,
        raw: rec as any,
      };
    }

    const res = await this.daraja.stkQuery(checkoutRequestId);
    if (res.ResultCode === undefined) {
      // Query itself failed (e.g. transaction not yet visible)
      return { status: PaymentStatus.PENDING, raw: res as any };
    }
    const code = Number(res.ResultCode);
    return {
      status: code === 0 ? PaymentStatus.SUCCESS : PaymentStatus.FAILED,
      raw: res as any,
    };
  }

  async refund(opts: { providerRef: string; amountCents: number; receipt?: string }): Promise<RefundResult> {
    if (this.mode === 'mock') {
      this.logger.log(`[MOCK] Refund ${opts.amountCents}c for ${opts.providerRef}`);
      return { providerRef: `MOCK-REFUND-${Date.now()}`, status: 'SUCCESS', raw: { mock: true } };
    }
    // NOTE: requires B2C credentials and PartyB. Real refunds go via B2C with the
    // customer's phone — that phone is stored on the Payment row and passed by the RefundsService.
    throw new Error('Real B2C refunds are invoked from RefundsService with the payment phone');
  }
}
