import { HttpException, HttpStatus, Injectable, Logger } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import axios, { AxiosInstance } from 'axios';
import { ErrorCode, toDarajaAmount } from '@sokoni/shared';
import { RedisService } from '../../redis/redis.service';

const OAUTH_CACHE_KEY = 'mpesa:oauth:token';

export interface DarajaStkResponse {
  MerchantRequestID: string;
  CheckoutRequestID: string;
  ResponseCode: string;
  ResponseDescription: string;
  CustomerMessage: string;
}

export interface DarajaStkQueryResponse {
  ResponseCode: string;
  ResponseDescription: string;
  MerchantRequestID?: string;
  CheckoutRequestID?: string;
  ResultCode?: string;
  ResultDesc?: string;
}

@Injectable()
export class DarajaClient {
  private readonly logger = new Logger(DarajaClient.name);
  private readonly http: AxiosInstance;
  private readonly baseUrl: string;
  private readonly shortcode: string;
  private readonly passkey: string;
  private readonly consumerKey: string;
  private readonly consumerSecret: string;

  constructor(private readonly config: ConfigService, private readonly redis: RedisService) {
    this.baseUrl = config.getOrThrow<string>('MPESA_BASE_URL');
    this.shortcode = config.getOrThrow<string>('MPESA_SHORTCODE');
    this.passkey = config.getOrThrow<string>('MPESA_PASSKEY');
    this.consumerKey = config.getOrThrow<string>('MPESA_CONSUMER_KEY');
    this.consumerSecret = config.getOrThrow<string>('MPESA_CONSUMER_SECRET');
    this.http = axios.create({ baseURL: this.baseUrl, timeout: 20_000 });
  }

  async getAccessToken(): Promise<string> {
    const cached = await this.redis.get<string>(OAUTH_CACHE_KEY);
    if (cached && typeof cached === 'string') return cached;

    const basic = Buffer.from(`${this.consumerKey}:${this.consumerSecret}`).toString('base64');
    try {
      const res = await this.http.get('/oauth/v1/generate', {
        params: { grant_type: 'client_credentials' },
        headers: { Authorization: `Basic ${basic}` },
      });
      const token: string = res.data.access_token;
      const expiresIn = Number(res.data.expires_in ?? 3599);
      // Cache with 60s safety margin
      await this.redis.set(OAUTH_CACHE_KEY, token, Math.max(30, expiresIn - 60));
      return token;
    } catch (err: any) {
      this.logger.error(`Daraja OAuth failed: ${err?.response?.data?.errorMessage ?? err.message}`);
      throw new HttpException(
        { code: ErrorCode.PAYMENT_PROVIDER_ERROR, message: 'M-Pesa auth failed' },
        HttpStatus.BAD_GATEWAY,
      );
    }
  }

  private timestamp(): string {
    const d = new Date();
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getUTCFullYear()}${pad(d.getUTCMonth() + 1)}${pad(d.getUTCDate())}${pad(d.getUTCHours())}${pad(d.getUTCMinutes())}${pad(d.getUTCSeconds())}`;
  }

  private stkPassword(ts: string): string {
    // Password = base64(Shortcode + Passkey + Timestamp)
    return Buffer.from(`${this.shortcode}${this.passkey}${ts}`).toString('base64');
  }

  async stkPush(opts: {
    phone: string;
    amountCents: number;
    accountReference: string;
    callbackUrl: string;
    description?: string;
  }): Promise<DarajaStkResponse> {
    const token = await this.getAccessToken();
    const ts = this.timestamp();
    const amount = toDarajaAmount(opts.amountCents);
    const payload = {
      BusinessShortCode: this.shortcode,
      Password: this.stkPassword(ts),
      Timestamp: ts,
      TransactionType: 'CustomerPayBillOnline',
      Amount: amount,
      PartyA: opts.phone,
      PartyB: this.shortcode,
      PhoneNumber: opts.phone,
      CallBackURL: opts.callbackUrl,
      AccountReference: opts.accountReference,
      TransactionDesc: opts.description ?? 'Sokoni order payment',
    };

    try {
      const res = await this.http.post('/mpesa/stkpush/v1/processrequest', payload, {
        headers: { Authorization: `Bearer ${token}` },
      });
      return res.data;
    } catch (err: any) {
      const detail = err?.response?.data ?? { message: err.message };
      this.logger.error(`STK push failed: ${JSON.stringify(detail)}`);
      throw new HttpException(
        { code: ErrorCode.PAYMENT_PROVIDER_ERROR, message: detail.errorMessage ?? 'STK push failed', details: detail },
        HttpStatus.BAD_GATEWAY,
      );
    }
  }

  async stkQuery(checkoutRequestId: string): Promise<DarajaStkQueryResponse> {
    const token = await this.getAccessToken();
    const ts = this.timestamp();
    const payload = {
      BusinessShortCode: this.shortcode,
      Password: this.stkPassword(ts),
      Timestamp: ts,
      CheckoutRequestID: checkoutRequestId,
    };
    try {
      const res = await this.http.post('/mpesa/stkpushquery/v1/query', payload, {
        headers: { Authorization: `Bearer ${token}` },
      });
      return res.data;
    } catch (err: any) {
      const detail = err?.response?.data ?? { message: err.message };
      // 500.001.1001 = "transaction does not exist" is unreliable; treat as pending
      return {
        ResponseCode: detail.errorCode ?? 'ERROR',
        ResponseDescription: detail.errorMessage ?? err.message,
      };
    }
  }

  async b2cRefund(opts: {
    phone: string;
    amountCents: number;
    remarks: string;
    occasion?: string;
  }): Promise<Record<string, unknown>> {
    const token = await this.getAccessToken();
    const payload = {
      InitiatorName: this.config.getOrThrow<string>('MPESA_B2C_INITIATOR_NAME'),
      SecurityCredential: this.config.getOrThrow<string>('MPESA_B2C_SECURITY_CREDENTIAL'),
      CommandID: 'BusinessPayment',
      Amount: toDarajaAmount(opts.amountCents),
      PartyA: this.config.getOrThrow<string>('MPESA_B2C_SHORTCODE'),
      PartyB: opts.phone,
      Remarks: opts.remarks,
      QueueTimeOutURL: this.config.getOrThrow<string>('MPESA_B2C_TIMEOUT_URL'),
      ResultURL: this.config.getOrThrow<string>('MPESA_B2C_RESULT_URL'),
      Occasion: opts.occasion ?? 'Refund',
    };
    try {
      const res = await this.http.post('/mpesa/b2c/v1/paymentrequest', payload, {
        headers: { Authorization: `Bearer ${token}` },
      });
      return res.data;
    } catch (err: any) {
      const detail = err?.response?.data ?? { message: err.message };
      this.logger.error(`B2C refund failed: ${JSON.stringify(detail)}`);
      throw new HttpException(
        { code: ErrorCode.PAYMENT_PROVIDER_ERROR, message: 'B2C refund failed', details: detail },
        HttpStatus.BAD_GATEWAY,
      );
    }
  }
}
