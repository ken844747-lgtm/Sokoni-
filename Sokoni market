export interface CouponValidation {
  valid: boolean;
  discountCents: number;
  coupon?: { code: string; type: string; value: number };
  reason?: string;
}

@Injectable()
export class CouponsService {
  constructor(private readonly prisma: PrismaService) {}

  async validate(code: string, subtotalCents: number, userId?: string): Promise<CouponValidation> {
    const normalized = code.trim().toUpperCase();
    const coupon = await this.prisma.coupon.findUnique({ where: { code: normalized } });
    if (!coupon || !coupon.isActive) return { valid: false, discountCents: 0, reason: 'Coupon not found' };

    const now = new Date();
    if (coupon.startsAt && coupon.startsAt > now) return { valid: false, discountCents: 0, reason: 'Coupon not yet active' };
    if (coupon.endsAt && coupon.endsAt < now) return { valid: false, discountCents: 0, reason: 'Coupon has expired' };
    if (coupon.usageLimit != null && coupon.usedCount >= coupon.usageLimit) return { valid: false, discountCents: 0, reason: 'Coupon fully redeemed' };
    if (subtotalCents < coupon.minSubtotalCents) {
      return { valid: false, discountCents: 0, reason: `Minimum spend is ${coupon.minSubtotalCents / 100} KES` };
    }

    let discountCents = 0;
    if (coupon.type === 'PERCENT') {
      discountCents = Math.round((subtotalCents * coupon.value) / 100);
    } else if (coupon.type === 'FIXED') {
      discountCents = coupon.value;
    }
    if (coupon.maxDiscountCents != null) discountCents = Math.min(discountCents, coupon.maxDiscountCents);
    discountCents = Math.min(discountCents, subtotalCents);

    return {
      valid: true,
      discountCents,
      coupon: { code: coupon.code, type: coupon.type, value: coupon.value },
    };
  }

  async applyUsage(code: string, tx?: any) {
    const client = tx ?? this.prisma;
    await client.coupon.update({
      where: { code: code.toUpperCase() },
      data: { usedCount: { increment: 1 } },
    });
  }

  async listAdmin() {
    return this.prisma.coupon.findMany({ orderBy: { createdAt: 'desc' } });
  }

  async create(dto: {
    code: string; type: 'PERCENT' | 'FIXED'; value: number;
    description?: string; minSubtotalCents?: number; maxDiscountCents?: number;
    usageLimit?: number; perUserLimit?: number;
    startsAt?: Date; endsAt?: Date; isActive?: boolean;
  }) {
    return this.prisma.coupon.create({
      data: {
        code: dto.code.toUpperCase(),
        type: dto.type,
        value: dto.value,
        description: dto.description,
        minSubtotalCents: dto.minSubtotalCents ?? 0,
        maxDiscountCents: dto.maxDiscountCents,
        usageLimit: dto.usageLimit,
        perUserLimit: dto.perUserLimit ?? 1,
        startsAt: dto.startsAt,
        endsAt: dto.endsAt,
        isActive: dto.isActive ?? true,
      },
    });
  }
}
