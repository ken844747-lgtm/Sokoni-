    this.records.set(checkoutRequestId, {
      checkoutRequestId,
      merchantRequestId,
      phone: input.phone,
      amountKes: input.amountKes,
      accountReference: input.accountReference,
      createdAt: Date.now(),
      status: 'PENDING',
    });
    this.logger.log(`[MOCK] STK push → ${input.phone} for KES ${input.amountKes} (${checkoutRequestId})`);
