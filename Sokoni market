import { ConfigService } from '@nestjs/config';
import axios, { AxiosInstance } from 'axios';
import { createHmac, timingSafeEqual } from 'crypto';
import { ErrorCode, fromCents } from '@sokoni/shared';

@Injectable()
export class FlutterwaveClient {
  private readonly logger = new Logger(FlutterwaveClient.name);
  private readonly http: AxiosInstance;
  private readonly secretKey: string;
  private readonly secretHash: string;

  constructor(private readonly config: ConfigService) {
    this.secretKey = config.getOrThrow<string>('FLW_SECRET_KEY');
    this.secretHash = config.getOrThrow<string>('FLW_SECRET_HASH');
    this.http = axios.create({
      baseURL: config.getOrThrow<string>('FLW_BASE_URL'),
      timeout: 20_000,
      headers: { Authorization: `Bearer ${this.secretKey}` },
    });
  }

  async initiatePayment(opts: {
    txRef: string;
    amountCents: number;
    currency: 'KES';
    redirectUrl: string;
    customerEmail: string;
    customerName: string;
    customerPhone?: string;
    title: string;
  }): Promise<{ checkoutUrl: string; txRef: string; raw: Record<string, unknown> }> {
    try {
      const res = await this.http.post('/payments', {
        tx_ref: opts.txRef,
        amount: fromCents(opts.amountCents),
        currency: opts.currency,
        redirect_url: opts.redirectUrl,
        payment_options: 'card,mobilemoney',
        customer: {
          email: opts.customerEmail,
          name: opts.customerName,
          phonenumber: opts.customerPhone,
        },
        customizations: {
          title: opts.title,
          description: 'Sokoni order payment',
        },
      });
      return {
        checkoutUrl: res.data.data.link,
        txRef: opts.txRef,
        raw: res.data,
      };
    } catch (err: any) {
      const detail = err?.response?.data ?? { message: err.message };
      this.logger.error(`Flutterwave initiate failed: ${JSON.stringify(detail)}`);
      throw new HttpException(
        { code: ErrorCode.PAYMENT_PROVIDER_ERROR, message: 'Card payment init failed', details: detail },
        HttpStatus.BAD_GATEWAY,
      );
    }
  }

  async verifyTransaction(transactionId: string): Promise<Record<string, unknown>> {
    try {
      const res = await this.http.get(`/transactions/${transactionId}/verify`);
      return res.data;
    } catch (err: any) {
      const detail = err?.response?.data ?? { message: err.message };
      throw new HttpException(
        { code: ErrorCode.PAYMENT_PROVIDER_ERROR, message: 'Card verification failed', details: detail },
        HttpStatus.BAD_GATEWAY,
      );
    }
  }

  /**
   * Flutterwave webhook auth: `verif-hash` header must equal FLW_SECRET_HASH.
   * Constant-time compare. Always respond 200 to acknowledge.
   */
  verifyWebhookSignature(signature: string | undefined): boolean {
    if (!signature || !this.secretHash) return false;
    const a = Buffer.from(signature);
    const b = Buffer.from(this.secretHash);
    return a.length === b.length && timingSafeEqual(a, b);
  }
}
