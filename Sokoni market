import { HttpException, HttpStatus, Injectable } from '@nestjs/common';
import { ErrorCode, Role, VendorStatus } from '@sokoni/shared';
import slugify from 'slugify';
import { PrismaService } from '../prisma/prisma.service';
import { AuditService } from '../audit/audit.service';
import { NotificationsService } from '../notifications/notifications.service';
import { ApplyVendorDto, ApproveVendorDto, UpdateVendorDto } from './dto/vendor.dto';
import { paginated } from '../common/utils/pagination';

@Injectable()
export class VendorsService {
  constructor(
    private readonly prisma: PrismaService,
    private readonly audit: AuditService,
    private readonly notifications: NotificationsService,
  ) {}

  async ensureForUser(userId: string, storeName: string) {
    const existing = await this.prisma.vendor.findUnique({ where: { userId } });
    if (existing) return existing;
    const baseSlug = slugify(storeName, { lower: true, strict: true });
    let slug = baseSlug;
    let i = 1;
    while (await this.prisma.vendor.findUnique({ where: { slug } })) slug = `${baseSlug}-${++i}`;
    return this.prisma.vendor.create({ data: { userId, storeName, slug, status: VendorStatus.PENDING } });
  }

  async apply(userId: string, dto: ApplyVendorDto) {
    const existing = await this.prisma.vendor.findUnique({ where: { userId } });
    if (existing) {
      throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Vendor application already exists' }, HttpStatus.CONFLICT);
    }
    const baseSlug = slugify(dto.storeName, { lower: true, strict: true });
    let slug = baseSlug;
    let i = 1;
    while (await this.prisma.vendor.findUnique({ where: { slug } })) slug = `${baseSlug}-${++i}`;
    const vendor = await this.prisma.vendor.create({
      data: {
        userId,
        storeName: dto.storeName,
        slug,
        description: dto.description,
        logoUrl: dto.logoUrl,
        bannerUrl: dto.bannerUrl,
        countyCode: dto.countyCode,
        phone: dto.phone,
        email: dto.email,
        payoutMethod: dto.payoutMethod,
        payoutPhone: dto.payoutPhone,
        status: VendorStatus.PENDING,
      },
    });
    await this.prisma.user.update({ where: { id: userId }, data: { role: Role.VENDOR } });
    await this.audit.record({ actorId: userId, action: 'VENDOR_APPLIED', entity: 'Vendor', entityId: vendor.id });
    return vendor;
  }

  async mine(userId: string) {
    return this.prisma.vendor.findUnique({
      where: { userId },
      include: {
        _count: { select: { products: true, payouts: true } },
      },
    });
  }

  async requireApproved(vendorId: string) {
    const vendor = await this.prisma.vendor.findUnique({ where: { id: vendorId } });
    if (!vendor) throw new HttpException({ code: ErrorCode.NOT_FOUND, message: 'Vendor not found' }, HttpStatus.NOT_FOUND);
    if (vendor.status !== VendorStatus.APPROVED) {
      throw new HttpException({ code: ErrorCode.AUTH_FORBIDDEN, message: 'Vendor not approved' }, HttpStatus.FORBIDDEN);
    }
    return vendor;
  }

  async update(vendorId: string, dto: UpdateVendorDto) {
    return this.prisma.vendor.update({ where: { id: vendorId }, data: dto as any });
  }

  // ── Admin ────────────────────────────────────────────────────────────
  async listAdmin(opts: { status?: VendorStatus; q?: string; page?: number; perPage?: number } = {}) {
    const page = opts.page ?? 1;
    const perPage = Math.min(opts.perPage ?? 30, 100);
    const where: any = {};
    if (opts.status) where.status = opts.status;
    if (opts.q) where.storeName = { contains: opts.q, mode: 'insensitive' };
    const [rows, total] = await Promise.all([
      this.prisma.vendor.findMany({
        where, orderBy: { createdAt: 'desc' }, include: { user: { select: { id: true, fullName: true, email: true, phone: true } } },
        skip: (page - 1) * perPage, take: perPage,
      }),
      this.prisma.vendor.count({ where }),
    ]);
    return paginated(rows, total, page, perPage);
  }

  async approve(adminId: string, vendorId: string, dto: ApproveVendorDto) {
    const vendor = await this.prisma.vendor.findUnique({ where: { id: vendorId } });
    if (!vendor) throw new HttpException({ code: ErrorCode.NOT_FOUND, message: 'Vendor not found' }, HttpStatus.NOT_FOUND);
    const updated = await this.prisma.vendor.update({
      where: { id: vendorId },
      data: {
        status: dto.status,
        rejectionReason: dto.status === VendorStatus.REJECTED ? dto.rejectionReason : null,
        approvedAt: dto.status === VendorStatus.APPROVED ? new Date() : vendor.approvedAt,
        commissionBps: dto.commissionBps ?? vendor.commissionBps,
      },
    });
    await this.audit.record({
      actorId: adminId,
      action: `VENDOR_${dto.status}`,
      entity: 'Vendor',
      entityId: vendorId,
      before: { status: vendor.status },
      after: { status: updated.status, reason: dto.rejectionReason },
    });
    await this.notifications.notify({
      userId: vendor.userId,
      title: `Vendor application ${dto.status.toLowerCase()}`,
      body: dto.status === VendorStatus.APPROVED
        ? `Congratulations! ${vendor.storeName} is approved. Start listing products.`
        : `Your vendor application was ${dto.status.toLowerCase()}. ${dto.rejectionReason ?? ''}`,
    });
    return updated;
  }
}
