    private readonly daraja: DarajaClient,
    private readonly flw: FlutterwaveClient,
    private readonly mockDaraja: MockDarajaStore,
    @InjectQueue(QUEUE_NAMES.PAYMENTS) private readonly paymentsQueue: Queue,
  ) {}

  private get mode(): 'mock' | 'sandbox' | 'production' {
    return this.config.get<'mock' | 'sandbox' | 'production'>('MPESA_MODE', 'mock');
  }

  private async acquireLock(key: string, ttlSec: number): Promise<boolean> {
    const res = await this.redis.client.set(key, '1', 'EX', ttlSec, 'NX');
    return res === 'OK';
  }

  /**
   * Initiate M-Pesa STK push for an order.
   * - Idempotent within PAYMENT_STK_COOLDOWN_SECONDS via Redis lock
   * - Prevents duplicate CheckoutRequestIDs per order
   */
  async initiateMpesaStk(userId: string, req: StkPushRequest) {
    const phone = normalizeKenyanPhone(req.phone);
    if (!phone) {
      throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Invalid Kenyan phone' }, HttpStatus.BAD_REQUEST);
    }
    if (!isSafaricomNumber(phone)) {
      throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'M-Pesa requires a Safaricom number' }, HttpStatus.BAD_REQUEST);
    }

    const order = await this.prisma.order.findUnique({ where: { id: req.orderId }, include: { payments: true } });
    if (!order || order.userId !== userId) {
      throw new HttpException({ code: ErrorCode.ORDER_NOT_FOUND, message: 'Order not found' }, HttpStatus.NOT_FOUND);
    }
    if (order.status !== OrderStatus.PENDING_PAYMENT) {
      throw new HttpException({ code: ErrorCode.ORDER_ALREADY_PAID, message: `Order is ${order.status}` }, HttpStatus.BAD_REQUEST);
    }

    // Cooldown lock
    const cooldownSec = this.config.get<number>('PAYMENT_STK_COOLDOWN_SECONDS', 120);
    const lockKey = `stk:lock:${order.id}`;
    const acquired = await this.acquireLock(lockKey, cooldownSec);
    if (!acquired) {
      throw new HttpException(
        { code: ErrorCode.PAYMENT_COOLDOWN, message: `Please wait before retrying. Existing prompt is active.` },
        HttpStatus.TOO_MANY_REQUESTS,
      );
    }

    // Idempotency key (return existing pending if present)
    const idempotencyKey = `stk:${order.id}:${phone}`;
    const existing = await this.prisma.idempotencyKey.findUnique({
      where: { key_scope: { key: idempotencyKey, scope: 'STK_PUSH' } },
    });
    if (existing) {
      const data = existing.responseData as any;
      if (data?.checkoutRequestId) {
        const pay = await this.prisma.payment.findUnique({ where: { checkoutRequestId: data.checkoutRequestId } });
        if (pay && pay.status === PrismaPaymentStatus.PENDING) {
          return { payment: pay, customerMessage: 'A prompt was already sent. Check your phone.' };
        }
      }
    }

    const callbackToken = this.config.getOrThrow<string>('MPESA_CALLBACK_TOKEN');
    const apiUrl = this.config.getOrThrow<string>('API_URL');
    const callbackUrl = `${apiUrl}/api/v1/payments/mpesa/callback/${callbackToken}`;

    let initiated: { providerRef: string; merchantRef?: string; customerMessage?: string; raw: any };
    if (this.mode === 'mock') {
      const res = this.mockDaraja.stkPush({
        phone,
        amountKes: order.totalCents / 100,
        accountReference: order.orderNumber,
      });
      initiated = {
        providerRef: res.checkoutRequestId,
        merchantRef: res.merchantRequestId,
        customerMessage: res.customerMessage,
        raw: { mock: true, ...res },
      };
    } else {
      const res = await this.daraja.stkPush({
        phone,
        amountCents: order.totalCents,
        accountReference: order.orderNumber,
        callbackUrl,
      });
      if (res.ResponseCode !== '0') {
        await this.redis.del(lockKey);
        throw new HttpException({ code: ErrorCode.PAYMENT_PROVIDER_ERROR, message: res.ResponseDescription }, HttpStatus.BAD_GATEWAY);
      }
      initiated = {
        providerRef: res.CheckoutRequestID,
        merchantRef: res.MerchantRequestID,
        customerMessage: res.CustomerMessage,
        raw: res as any,
      };
    }

    const payment = await this.prisma.payment.create({
      data: {
        orderId: order.id,
        provider: PrismaPaymentProvider.MPESA_STK,
        status: PrismaPaymentStatus.PENDING,
        amountCents: order.totalCents,
        phone,
        accountReference: order.orderNumber,
        checkoutRequestId: initiated.providerRef,
        merchantRequestId: initiated.merchantRef ?? null,
        idempotencyKey,
        rawPayload: initiated.raw as any,
        expiresAt: new Date(Date.now() + 10 * 60_000),
      },
    });

    await this.prisma.idempotencyKey.create({
      data: {
        key: idempotencyKey,
        scope: 'STK_PUSH',
        responseData: { checkoutRequestId: initiated.providerRef, paymentId: payment.id },
        expiresAt: new Date(Date.now() + 24 * 3600_000),
      },
    });

    // Query fallback jobs at +30s, +60s, +120s
    const attempts = [30_000, 60_000, 120_000];
    for (let i = 0; i < attempts.length; i++) {
      await this.paymentsQueue.add(
        'stk-query',
        { paymentId: payment.id, attempt: i + 1 },
        { delay: attempts[i], jobId: `stk-query-${payment.id}-${i + 1}` },
      );
    }

    await this.audit.record({
      actorId: userId,
      action: 'PAYMENT_STK_INITIATED',
      entity: 'Payment',
      entityId: payment.id,
      after: { orderId: order.id, providerRef: initiated.providerRef, amountCents: order.totalCents },
    });

    return { payment, customerMessage: initiated.customerMessage };
  }

  /**
   * Handle Safaricom STK callback. Must always respond 200 {ResultCode:0} quickly.
   * Idempotent: duplicate CheckoutRequestID or MpesaReceiptNumber is a safe no-op.
   */
  async handleMpesaCallback(payload: any): Promise<{ ResultCode: number; ResultDesc: string }> {
    const response = { ResultCode: 0, ResultDesc: 'Accepted' };
    try {
      const stk = payload?.Body?.stkCallback;
      if (!stk) {
        this.logger.warn('Callback missing Body.stkCallback');
        return response;
      }
      const { CheckoutRequestID, MerchantRequestID, ResultCode, ResultDesc, CallbackMetadata } = stk;
      if (!CheckoutRequestID) return response;

      const payment = await this.prisma.payment.findUnique({ where: { checkoutRequestId: CheckoutRequestID } });
      if (!payment) {
        this.logger.warn(`Callback for unknown CheckoutRequestID ${CheckoutRequestID}`);
        return response;
      }

      // Idempotency: if already terminal, ack and return
      if (payment.status === PrismaPaymentStatus.SUCCESS || payment.status === PrismaPaymentStatus.FAILED || payment.status === PrismaPaymentStatus.EXPIRED) {
        this.logger.log(`Duplicate callback ignored for ${CheckoutRequestID} (status=${payment.status})`);
        return response;
      }

      const code = Number(ResultCode);
      const friendly: Record<number, string> = {
        0: 'Payment received',
        1: 'Insufficient M-Pesa balance',
        1032: 'Cancelled by user',
        1037: 'Timeout — no response from phone',
        2001: 'Wrong PIN entered',
      };

      // Extract metadata
      const meta = (CallbackMetadata?.Item ?? []).reduce((acc: any, it: any) => {
        acc[it.Name] = it.Value;
        return acc;
      }, {});
      const receipt: string | undefined = meta.MpesaReceiptNumber;
      const paidAmountKes: number | undefined = meta.Amount;

      if (code === 0) {
        // Amount check
        const expectedCents = payment.amountCents;
        const paidCents = paidAmountKes !== undefined ? toCents(paidAmountKes) : expectedCents;
        if (paidCents !== expectedCents) {
          this.logger.error(`Amount mismatch for ${payment.id}: expected ${expectedCents} got ${paidCents}`);
          await this.prisma.payment.update({
            where: { id: payment.id },
            data: {
              status: PrismaPaymentStatus.FAILED,
              resultCode: code,
              resultDesc: 'Amount mismatch',
              failureReason: `Amount mismatch: expected ${expectedCents}, got ${paidCents}`,
              rawPayload: payload,
              completedAt: new Date(),
            },
          });
          return response;
        }

        try {
          await this.prisma.$transaction(async (tx) => {
            // Guard against duplicate receipt
            const dup = receipt
              ? await tx.payment.findFirst({ where: { mpesaReceipt: receipt, NOT: { id: payment.id } } })
              : null;
            if (dup) {
              this.logger.warn(`Duplicate MpesaReceiptNumber ${receipt} — marking current as duplicate`);
            }

            await tx.payment.update({
              where: { id: payment.id },
              data: {
                status: PrismaPaymentStatus.SUCCESS,
                mpesaReceipt: receipt,
                resultCode: code,
                resultDesc: ResultDesc,
                rawPayload: payload,
                completedAt: new Date(),
              },
            });

            // Transition order to PAID and consume reserved stock
            const order = await tx.order.findUnique({ where: { id: payment.orderId }, include: { items: true } });
            if (order && order.status === OrderStatus.PENDING_PAYMENT) {
              for (const item of order.items) {
                await tx.inventory.update({
                  where: { variantId: item.variantId },
                  data: {
                    reservedQty: { decrement: item.quantity },
                    quantity: { decrement: item.quantity },
                  },
                });
                await tx.product.update({
                  where: { id: item.productId },
                  data: { soldCount: { increment: item.quantity } },
                });
              }
              await tx.order.update({
                where: { id: order.id },
                data: {
                  status: OrderStatus.PAID,
                  paidAt: new Date(),
                  events: {
                    create: {
                      fromStatus: OrderStatus.PENDING_PAYMENT,
                      toStatus: OrderStatus.PAID,
                      note: `M-Pesa receipt ${receipt ?? 'n/a'}`,
                    },
                  },
                },
              });
            }
          });
        } catch (err: any) {
          this.logger.error(`Callback transaction failed: ${err.message}`);
          return response;
        }

        // Fire-and-forget notifications
        if (payment.phone) {
          await this.notifications.notify({
            userId: payment.orderId ? (await this.prisma.order.findUnique({ where: { id: payment.orderId } }))!.userId : '',
            title: 'Payment received',
            body: `Your payment was successful. Receipt: ${receipt ?? 'processing'}`,
            channels: [NotificationChannel.IN_APP, NotificationChannel.SMS],
          }).catch(() => undefined);
        }

        await this.audit.record({
          action: 'PAYMENT_MPESA_SUCCESS',
          entity: 'Payment',
          entityId: payment.id,
          after: { receipt, amountCents: paidCents },
        }).catch(() => undefined);
      } else {
        await this.prisma.payment.update({
          where: { id: payment.id },
          data: {
            status: PrismaPaymentStatus.FAILED,
            resultCode: code,
            resultDesc: ResultDesc ?? friendly[code] ?? 'Failed',
            failureReason: friendly[code] ?? 'Payment failed',
            rawPayload: payload,
            completedAt: new Date(),
          },
        });
        await this.audit.record({
          action: 'PAYMENT_MPESA_FAILED',
          entity: 'Payment',
          entityId: payment.id,
          after: { resultCode: code, resultDesc: ResultDesc },
        }).catch(() => undefined);
      }
    } catch (err: any) {
      this.logger.error(`Callback error (still ACKing): ${err.message}`);
    }
    return response;
  }

  /** Called by BullMQ processor after 30/60/120s if no callback. */
  async queryPendingPayment(paymentId: string): Promise<void> {
    const payment = await this.prisma.payment.findUnique({ where: { id: paymentId } });
    if (!payment || payment.status !== PrismaPaymentStatus.PENDING || !payment.checkoutRequestId) return;

    if (this.mode === 'mock') {
      const rec = this.mockDaraja.query(payment.checkoutRequestId);
      if (!rec || rec.status === 'PENDING') return;
      // Synthesize a callback from the mock record
      const fakeCallback = {
        Body: {
          stkCallback: {
            MerchantRequestID: rec.merchantRequestId,
            CheckoutRequestID: rec.checkoutRequestId,
            ResultCode: rec.resultCode ?? 0,
            ResultDesc: rec.resultDesc ?? 'The service request is processed successfully.',
            CallbackMetadata: rec.status === 'SUCCESS' ? {
              Item: [
                { Name: 'Amount', Value: rec.amountKes },
                { Name: 'MpesaReceiptNumber', Value: rec.receipt },
                { Name: 'TransactionDate', Value: Date.now() },
                { Name: 'PhoneNumber', Value: rec.phone },
              ],
            } : undefined,
          },
        },
      };
      await this.handleMpesaCallback(fakeCallback);
      return;
    }

    const res = await this.daraja.stkQuery(payment.checkoutRequestId);
    if (res.ResultCode !== undefined && Number(res.ResultCode) === 0) {
      // Query says success but no callback yet — synthesize callback for the pipeline
      await this.handleMpesaCallback({
        Body: {
          stkCallback: {
            MerchantRequestID: payment.merchantRequestId,
            CheckoutRequestID: payment.checkoutRequestId,
            ResultCode: 0,
            ResultDesc: 'Query reported success',
            CallbackMetadata: { Item: [{ Name: 'Amount', Value: payment.amountCents / 100 }] },
          },
        },
      });
    }
  }

  /** Initiate card checkout via Flutterwave. Returns redirect URL. */
  async initiateFlutterwave(userId: string, orderId: string) {
    if (!this.config.get<boolean>('FLW_ENABLED', false)) {
      throw new HttpException({ code: ErrorCode.PAYMENT_PROVIDER_ERROR, message: 'Card payments disabled' }, HttpStatus.BAD_REQUEST);
    }
    const order = await this.prisma.order.findUnique({ where: { id: orderId }, include: { user: true } });
    if (!order || order.userId !== userId) throw new HttpException({ code: ErrorCode.ORDER_NOT_FOUND, message: 'Order not found' }, HttpStatus.NOT_FOUND);
    if (order.status !== OrderStatus.PENDING_PAYMENT) throw new HttpException({ code: ErrorCode.ORDER_ALREADY_PAID, message: 'Order not pending' }, HttpStatus.BAD_REQUEST);

    const txRef = `SK-FLW-${order.orderNumber}-${Date.now()}`;
    const apiUrl = this.config.getOrThrow<string>('API_URL');
    const webUrl = this.config.getOrThrow<string>('WEB_URL');
    const redirectUrl = `${webUrl}/checkout/flutterwave/callback?order=${order.orderNumber}`;

    const initiated = await this.flw.initiatePayment({
      txRef,
      amountCents: order.totalCents,
      currency: 'KES',
      redirectUrl,
      customerEmail: order.user.email ?? 'customer@sokoni.co.ke',
      customerName: order.contactName,
      customerPhone: order.contactPhone,
      title: 'Sokoni',
    });

    const payment = await this.prisma.payment.create({
      data: {
        orderId: order.id,
        provider: PrismaPaymentProvider.FLUTTERWAVE,
        status: PrismaPaymentStatus.PENDING,
        amountCents: order.totalCents,
        providerRef: txRef,
        rawPayload: initiated.raw as any,
      },
    });

    return { payment, checkoutUrl: initiated.checkoutUrl };
  }

  /** Flutterwave webhook — verify signature, dedupe, re-verify transaction, then transition. */
  async handleFlutterwaveWebhook(signature: string | undefined, payload: any): Promise<void> {
    if (!this.flw.verifyWebhookSignature(signature)) {
      this.logger.warn('Flutterwave webhook signature mismatch — rejecting');
      return;
    }
    const eventId: string = payload?.data?.id?.toString() ?? payload?.data?.tx_ref ?? randomUUID();
    const existing = await this.prisma.webhookEvent.findUnique({
      where: { provider_eventId: { provider: 'flutterwave', eventId } },
    }).catch(() => null);
    if (existing?.processedAt) return;

    await this.prisma.webhookEvent.upsert({
      where: { provider_eventId: { provider: 'flutterwave', eventId } },
      create: { provider: 'flutterwave', eventId, eventType: payload?.event ?? 'unknown', payload, signature },
      update: { signature, payload },
    });

    if (payload?.event !== 'charge.completed') {
      await this.prisma.webhookEvent.update({
        where: { provider_eventId: { provider: 'flutterwave', eventId } },
        data: { processedAt: new Date() },
      });
      return;
    }

    const txRef: string = payload.data.tx_ref;
    const payment = await this.prisma.payment.findFirst({ where: { providerRef: txRef } });
    if (!payment) return;

    // Re-verify server-side
    const ver = await this.flw.verifyTransaction(payload.data.id.toString());
    const data = (ver as any).data ?? {};
    if (data.status !== 'successful') return;

    await this.prisma.$transaction(async (tx) => {
      await tx.payment.update({
        where: { id: payment.id },
        data: {
          status: PrismaPaymentStatus.SUCCESS,
          providerTxId: payload.data.id.toString(),
          completedAt: new Date(),
          rawPayload: ver as any,
        },
      });
      const order = await tx.order.findUnique({ where: { id: payment.orderId }, include: { items: true } });
      if (order && order.status === OrderStatus.PENDING_PAYMENT) {
        for (const item of order.items) {
          await tx.inventory.update({
            where: { variantId: item.variantId },
            data: { reservedQty: { decrement: item.quantity }, quantity: { decrement: item.quantity } },
          });
        }
        await tx.order.update({
          where: { id: order.id },
          data: {
            status: OrderStatus.PAID,
            paidAt: new Date(),
            events: { create: { fromStatus: OrderStatus.PENDING_PAYMENT, toStatus: OrderStatus.PAID, note: 'Flutterwave card payment' } },
          },
        });
      }
    });

    await this.prisma.webhookEvent.update({
      where: { provider_eventId: { provider: 'flutterwave', eventId } },
      data: { processedAt: new Date() },
    });
  }

  /** Pay on delivery — mark order CONFIRMED with payment UNPAID */
  async initiatePayOnDelivery(userId: string, orderId: string) {
    if (!this.config.get<boolean>('POD_ENABLED', true)) {
      throw new HttpException({ code: ErrorCode.PAYMENT_PROVIDER_ERROR, message: 'Pay on delivery disabled' }, HttpStatus.BAD_REQUEST);
    }
    const order = await this.prisma.order.findUnique({ where: { id: orderId } });
    if (!order || order.userId !== userId) throw new HttpException({ code: ErrorCode.ORDER_NOT_FOUND, message: 'Order not found' }, HttpStatus.NOT_FOUND);
    if (order.status !== OrderStatus.PENDING_PAYMENT) throw new HttpException({ code: ErrorCode.ORDER_ALREADY_PAID, message: 'Order not pending' }, HttpStatus.BAD_REQUEST);

    const payment = await this.prisma.payment.create({
      data: {
        orderId,
        provider: PrismaPaymentProvider.POD,
        status: PrismaPaymentStatus.PENDING,
        amountCents: order.totalCents,
      },
    });
    await this.orders.transitionOrder({
      orderId,
      to: OrderStatus.PROCESSING, // POD skips PAID and goes directly to PROCESSING
      actorId: userId,
      actorRole: 'CUSTOMER',
      note: 'Pay on delivery selected',
    });
    return { payment, message: 'Order confirmed. Pay on delivery.' };
  }
}
import { Body, Controller, Get, Headers, HttpCode, Ip, Param, Post, Req, Res, UseGuards } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { ApiTags } from '@nestjs/swagger';
import { IsString, Matches } from 'class-validator';
import { Request, Response } from 'express';
import { AuthUser, CurrentUser } from '../common/decorators/current-user.decorator';
import { Public } from '../common/decorators/public.decorator';
import { JwtAuthGuard } from '../common/guards/jwt-auth.guard';
import { PaymentsService } from './payments.service';

class StkPushDto {
  @IsString() orderId!: string;
  @Matches(/^(?:\+?254|0)[17]\d{8}$/, { message: 'Invalid Kenyan phone' }) phone!: string;
}

class OrderPaymentDto {
  @IsString() orderId!: string;
}

@ApiTags('payments')
@Controller('payments')
export class PaymentsController {
  constructor(private readonly payments: PaymentsService, private readonly config: ConfigService) {}

  @UseGuards(JwtAuthGuard)
  @Post('mpesa/stk-push')
  stkPush(@CurrentUser() user: AuthUser, @Body() dto: StkPushDto) {
    return this.payments.initiateMpesaStk(user.id, { orderId: dto.orderId, phone: dto.phone });
  }

  @UseGuards(JwtAuthGuard)
  @Post('flutterwave/initiate')
  flwInitiate(@CurrentUser() user: AuthUser, @Body() dto: OrderPaymentDto) {
    return this.payments.initiateFlutterwave(user.id, dto.orderId);
  }

  @UseGuards(JwtAuthGuard)
  @Post('pod/initiate')
  podInitiate(@CurrentUser() user: AuthUser, @Body() dto: OrderPaymentDto) {
    return this.payments.initiatePayOnDelivery(user.id, dto.orderId);
  }
}

/**
 * Public payment callbacks. All are @Public() and handled by their own auth
 * (callback token, IP allowlist, signature) rather than JWT/CSRF.
 */
@ApiTags('payments-callbacks')
@Controller('payments')
export class PaymentsCallbackController {
  private readonly logger = new Logger(PaymentsCallbackController.name);

  constructor(private readonly payments: PaymentsService, private readonly config: ConfigService) {}

  @Public()
  @Post('mpesa/callback/:token')
  @HttpCode(200)
  async mpesaCallback(
    @Param('token') token: string,
    @Ip() ip: string,
    @Req() req: Request,
    @Res() res: Response,
  ) {
    const expected = this.config.getOrThrow<string>('MPESA_CALLBACK_TOKEN');
    if (token !== expected) {
      this.logger.warn(`M-Pesa callback token mismatch from ${ip}`);
      res.status(404).end();
      return;
    }

    const allowlist = this.config.get<string[]>('MPESA_IP_ALLOWLIST', []);
    const mode = this.config.get<string>('MPESA_MODE', 'mock');
    if (mode !== 'mock' && allowlist.length > 0) {
      const ipClean = ip.replace(/^::ffff:/, '');
      if (!allowlist.includes(ipClean)) {
        this.logger.warn(`M-Pesa callback from non-allowlisted IP ${ipClean}`);
        // Still accept but log — Safaricom may change ranges. Tighten in production.
      }
    }

    const result = await this.payments.handleMpesaCallback(req.body);
    res.status(200).json(result);
  }

  @Public()
  @Post('flutterwave/webhook')
  @HttpCode(200)
  async flutterwaveWebhook(
    @Headers('verif-hash') signature: string,
    @Req() req: Request,
    @Res() res: Response,
  ) {
    await this.payments.handleFlutterwaveWebhook(signature, req.body);
    res.status(200).end();
  }

  @Public()
  @Post('mpesa/mock/:checkoutId/:outcome')
  @HttpCode(200)
  async mockComplete(
    @Param('checkoutId') checkoutId: string,
    @Param('outcome') outcome: 'succeed' | 'fail' | 'cancel',
    @Body() body: any,
  ) {
    if (this.config.get<string>('MPESA_MODE') !== 'mock') {
      throw new Error('Mock endpoints are disabled in non-mock mode');
    }
    const rec = (this.payments as any).mockDaraja.complete(checkoutId, outcome);
    if (!rec) return { message: 'Unknown checkout id' };
    // Immediately trigger the same pipeline
    const fakeCallback = {
      Body: {
        stkCallback: {
          MerchantRequestID: rec.merchantRequestId,
          CheckoutRequestID: rec.checkoutRequestId,
          ResultCode: rec.resultCode ?? 0,
          ResultDesc: rec.resultDesc ?? 'Mock',
          CallbackMetadata: rec.status === 'SUCCESS' ? {
            Item: [
              { Name: 'Amount', Value: rec.amountKes },
              { Name: 'MpesaReceiptNumber', Value: rec.receipt },
              { Name: 'TransactionDate', Value: Date.now() },
              { Name: 'PhoneNumber', Value: rec.phone },
            ],
          } : undefined,
        },
      },
    };
    return this.payments.handleMpesaCallback(fakeCallback);
  }
}
import { Processor, WorkerHost } from '@nestjs/bullmq';
import { Logger } from '@nestjs/common';
import { Job } from 'bullmq';
import { QUEUE_NAMES } from '../queue/queue.module';
import { PaymentsService } from './payments.service';

@Processor(QUEUE_NAMES.PAYMENTS)
export class PaymentsProcessor extends WorkerHost {
  private readonly logger = new Logger(PaymentsProcessor.name);
  constructor(private readonly payments: PaymentsService) {
    super();
  }

  async process(job: Job): Promise<void> {
    if (job.name === 'stk-query') {
      this.logger.debug(`STK query attempt ${job.data.attempt} for payment ${job.data.paymentId}`);
      await this.payments.queryPendingPayment(job.data.paymentId);
    }
  }
}
import { Module } from '@nestjs/common';
import { BullModule } from '@nestjs/bullmq';
import { NotificationsModule } from '../notifications/notifications.module';
import { OrdersModule } from '../orders/orders.module';
import { QUEUE_NAMES } from '../queue/queue.module';
import { PaymentsCallbackController, PaymentsController } from './payments.controller';
import { PaymentsProcessor } from './payments.processor';
import { PaymentsService } from './payments.service';
import { DarajaClient } from './providers/daraja.client';
import { FlutterwaveClient } from './providers/flutterwave.client';
import { FlutterwaveProvider } from './providers/flutterwave.provider';
import { MockDarajaStore } from './providers/mock-daraja.client';
