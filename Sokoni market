import { Queue } from 'bullmq';
import { randomUUID } from 'crypto';
import {
  ErrorCode, NotificationChannel, PaymentProvider, PaymentStatus, isSafaricomNumber, normalizeKenyanPhone, toCents,
} from '@sokoni/shared';
import { PrismaService } from '../prisma/prisma.service';
import { RedisService } from '../redis/redis.service';
import { NotificationsService } from '../notifications/notifications.service';
import { AuditService } from '../audit/audit.service';
import { OrdersService } from '../orders/orders.service';
import { QUEUE_NAMES } from '../queue/queue.module';
import { DarajaClient } from './providers/daraja.client';
import { FlutterwaveClient } from './providers/flutterwave.client';
import { MockDarajaStore } from './providers/mock-daraja.client';

export interface StkPushRequest {
  orderId: string;
  phone: string;
}

@Injectable()
export class PaymentsService {
  private readonly logger = new Logger(PaymentsService.name);

  constructor(
    private readonly prisma: PrismaService,
    private readonly redis: RedisService,
    private readonly config: ConfigService,
    private readonly notifications: NotificationsService,
    private readonly audit: AuditService,
    private readonly orders: OrdersService,
    private readonly daraja: DarajaClient,
    private readonly flw: FlutterwaveClient,
    private readonly mockDaraja: MockDarajaStore,
    @InjectQueue(QUEUE_NAMES.PAYMENTS) private readonly paymentsQueue: Queue,
  ) {}

  private get mode(): 'mock' | 'sandbox' | 'production' {
    return this.config.get<'mock' | 'sandbox' | 'production'>('MPESA_MODE', 'mock');
  }

  private async acquireLock(key: string, ttlSec: number): Promise<boolean> {
    const res = await this.redis.client.set(key, '1', 'EX', ttlSec, 'NX');
    return res === 'OK';
  }

  /**
   * Initiate M-Pesa STK push for an order.
   * - Idempotent within PAYMENT_STK_COOLDOWN_SECONDS via Redis lock
   * - Prevents duplicate CheckoutRequestIDs per order
   */
  async initiateMpesaStk(userId: string, req: StkPushRequest) {
    const phone = normalizeKenyanPhone(req.phone);
    if (!phone) {
      throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Invalid Kenyan phone' }, HttpStatus.BAD_REQUEST);
    }
    if (!isSafaricomNumber(phone)) {
      throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'M-Pesa requires a Safaricom number' }, HttpStatus.BAD_REQUEST);
    }

    const order = await this.prisma.order.findUnique({ where: { id: req.orderId }, include: { payments: true } });
    if (!order || order.userId !== userId) {
      throw new HttpException({ code: ErrorCode.ORDER_NOT_FOUND, message: 'Order not found' }, HttpStatus.NOT_FOUND);
    }
    if (order.status !== OrderStatus.PENDING_PAYMENT) {
      throw new HttpException({ code: ErrorCode.ORDER_ALREADY_PAID, message: `Order is ${order.status}` }, HttpStatus.BAD_REQUEST);
    }

    // Cooldown lock
    const cooldownSec = this.config.get<number>('PAYMENT_STK_COOLDOWN_SECONDS', 120);
    const lockKey = `stk:lock:${order.id}`;
    const acquired = await this.acquireLock(lockKey, cooldownSec);
    if (!acquired) {
      throw new HttpException(
        { code: ErrorCode.PAYMENT_COOLDOWN, message: `Please wait before retrying. Existing prompt is active.` },
        HttpStatus.TOO_MANY_REQUESTS,
      );
    }

    // Idempotency key (return existing pending if present)
    const idempotencyKey = `stk:${order.id}:${phone}`;
    const existing = await this.prisma.idempotencyKey.findUnique({
      where: { key_scope: { key: idempotencyKey, scope: 'STK_PUSH' } },
    });
    if (existing) {
      const data = existing.responseData as any;
      if (data?.checkoutRequestId) {
        const pay = await this.prisma.payment.findUnique({ where: { checkoutRequestId: data.checkoutRequestId } });
        if (pay && pay.status === PrismaPaymentStatus.PENDING) {
          return { payment: pay, customerMessage: 'A prompt was already sent. Check your phone.' };
        }
      }
    }

    const callbackToken = this.config.getOrThrow<string>('MPESA_CALLBACK_TOKEN');
    const apiUrl = this.config.getOrThrow<string>('API_URL');
    const callbackUrl = `${apiUrl}/api/v1/payments/mpesa/callback/${callbackToken}`;

    let initiated: { providerRef: string; merchantRef?: string; customerMessage?: string; raw: any };
    if (this.mode === 'mock') {
      const res = this.mockDaraja.stkPush({
        phone,
        amountKes: order.totalCents / 100,
        accountReference: order.orderNumber,
      });
      initiated = {
        providerRef: res.checkoutRequestId,
        merchantRef: res.merchantRequestId,
        customerMessage: res.customerMessage,
        raw: { mock: true, ...res },
      };
    } else {
      const res = await this.daraja.stkPush({
        phone,
        amountCents: order.totalCents,
        accountReference: order.orderNumber,
        callbackUrl,
      });
      if (res.ResponseCode !== '0') {
        await this.redis.del(lockKey);
        throw new HttpException({ code: ErrorCode.PAYMENT_PROVIDER_ERROR, message: res.ResponseDescription }, HttpStatus.BAD_GATEWAY);
      }
      initiated = {
        providerRef: res.CheckoutRequestID,
        merchantRef: res.MerchantRequestID,
        customerMessage: res.CustomerMessage,
        raw: res as any,
      };
    }

    const payment = await this.prisma.payment.create({
      data: {
        orderId: order.id,
        provider: PrismaPaymentProvider.MPESA_STK,
        status: PrismaPaymentStatus.PENDING,
        amountCents: order.totalCents,
        phone,
        accountReference: order.orderNumber,
        checkoutRequestId: initiated.providerRef,
        merchantRequestId: initiated.merchantRef ?? null,
        idempotencyKey,
        rawPayload: initiated.raw as any,
        expiresAt: new Date(Date.now() + 10 * 60_000),
      },
    });
