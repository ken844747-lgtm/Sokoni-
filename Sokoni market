@Injectable()
export class VendorAnalyticsService {
  constructor(private readonly prisma: PrismaService) {}

  async summary(vendorId: string) {
    const since = new Date(Date.now() - 30 * 86400_000);
    const [orders30, revenue30, pendingOrders, productCount, lowStock, items] = await Promise.all([
      this.prisma.order.count({ where: { items: { some: { vendorId } }, createdAt: { gte: since }, status: { in: ['PAID', 'PROCESSING', 'SHIPPED', 'DELIVERED'] } } }),
      this.prisma.orderItem.aggregate({ where: { vendorId, order: { createdAt: { gte: since }, status: { in: ['PAID', 'PROCESSING', 'SHIPPED', 'DELIVERED'] } } }, _sum: { vendorEarningCents: true } }),
      this.prisma.order.count({ where: { items: { some: { vendorId } }, status: { in: ['PAID', 'PROCESSING'] } } }),
      this.prisma.product.count({ where: { vendorId, status: { not: 'ARCHIVED' } } }),
      this.prisma.variant.count({ where: { product: { vendorId }, inventory: { quantity: { lt: 5 } } } }),
      this.prisma.orderItem.groupBy({
        by: ['productId'],
        where: { vendorId, order: { createdAt: { gte: since }, status: { in: ['PAID', 'PROCESSING', 'SHIPPED', 'DELIVERED'] } } },
        _sum: { quantity: true, lineTotalCents: true },
        orderBy: { _sum: { lineTotalCents: 'desc' } },
        take: 5,
      }),
    ]);
    const topProducts = await this.prisma.product.findMany({
      where: { id: { in: items.map((i) => i.productId) } },
      select: { id: true, name: true, images: true },
    });
    return {
      ordersLast30: orders30,
      revenueLast30Cents: revenue30._sum.vendorEarningCents ?? 0,
      pendingOrders,
      productCount,
      lowStockCount: lowStock,
      topProducts: items.map((i) => ({
        product: topProducts.find((p) => p.id === i.productId),
        unitsSold: i._sum.quantity ?? 0,
        revenueCents: i._sum.lineTotalCents ?? 0,
      })),
    };
  }

  async timeseries(vendorId: string, days = 14) {
    const rows = await this.prisma.$queryRaw<Array<{ d: Date; revenue: bigint; orders: bigint }>>`
      SELECT date_trunc('day', o."createdAt") AS d,
             COALESCE(SUM(oi."vendorEarningCents"), 0)::bigint AS revenue,
             COUNT(DISTINCT o.id)::bigint AS orders
      FROM "OrderItem" oi
      JOIN "Order" o ON o.id = oi."orderId"
      WHERE oi."vendorId" = ${vendorId}
        AND o."createdAt" >= NOW() - ${`${days} days`}::interval
        AND o.status IN ('PAID','PROCESSING','SHIPPED','DELIVERED')
      GROUP BY 1
      ORDER BY 1
    `;
    return rows.map((r) => ({ date: r.d.toISOString().slice(0, 10), revenueCents: Number(r.revenue), orders: Number(r.orders) }));
  }
}
