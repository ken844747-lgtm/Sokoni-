describe('PaymentsService.handleMpesaCallback', () => {
  let svc: PaymentsService;
  let prisma: any;
  let audit: any;

  const mockPayment = {
    id: 'pay_1',
    orderId: 'ord_1',
    amountCents: 100_00,
    status: PrismaPaymentStatus.PENDING,
    checkoutRequestId: 'ws_CO_123',
    merchantRequestId: 'MR_1',
    phone: '254701187557',
  };

  beforeEach(async () => {
    prisma = {
      payment: { findUnique: jest.fn().mockResolvedValue(mockPayment), update: jest.fn(), findFirst: jest.fn().mockResolvedValue(null) },
      order: { findUnique: jest.fn().mockResolvedValue({ id: 'ord_1', status: 'PENDING_PAYMENT', items: [], userId: 'u1' }), update: jest.fn() },
      inventory: { update: jest.fn() },
      product: { update: jest.fn() },
      $transaction: jest.fn(async (fn: any) => fn(prisma)),
      idempotencyKey: { findUnique: jest.fn(), create: jest.fn() },
      webhookEvent: { upsert: jest.fn(), update: jest.fn(), findUnique: jest.fn() },
    };
    audit = { record: jest.fn().mockResolvedValue(undefined) };
    const moduleRef = await Test.createTestingModule({
      providers: [
        PaymentsService,
        { provide: PrismaService, useValue: prisma },
        { provide: RedisService, useValue: { get: jest.fn(), set: jest.fn(), del: jest.fn(), client: { set: jest.fn().mockResolvedValue('OK') } } },
        { provide: ConfigService, useValue: { get: (k: string, d?: any) => ({ MPESA_MODE: 'mock', MPESA_CALLBACK_TOKEN: 'tok', API_URL: 'http://x', PAYMENT_STK_COOLDOWN_SECONDS: 120 }[k] ?? d) } },
        { provide: NotificationsService, useValue: { notify: jest.fn() } },
        { provide: AuditService, useValue: audit },
        { provide: OrdersService, useValue: {} },
        { provide: DarajaClient, useValue: {} },
        { provide: FlutterwaveClient, useValue: {} },
        { provide: MockDarajaStore, useValue: {} },
        { provide: 'BullQueue_payments', useValue: { add: jest.fn() } },
      ],
    }).compile();
    svc = moduleRef.get(PaymentsService);
  });

  it('success callback → SUCCESS + order PAID', async () => {
    const res = await svc.handleMpesaCallback({
      Body: { stkCallback: {
        MerchantRequestID: 'MR_1', CheckoutRequestID: 'ws_CO_123', ResultCode: 0, ResultDesc: 'ok',
        CallbackMetadata: { Item: [{ Name: 'Amount', Value: 100 }, { Name: 'MpesaReceiptNumber', Value: 'RCP123' }] },
      }},
    });
    expect(res.ResultCode).toBe(0);
    expect(prisma.payment.update).toHaveBeenCalledWith(expect.objectContaining({
      data: expect.objectContaining({ status: PrismaPaymentStatus.SUCCESS, mpesaReceipt: 'RCP123' }),
    }));
  });

  it('cancelled 1032 → FAILED', async () => {
    await svc.handleMpesaCallback({
      Body: { stkCallback: { MerchantRequestID: 'MR_1', CheckoutRequestID: 'ws_CO_123', ResultCode: 1032, ResultDesc: 'Cancelled' } },
    });
    expect(prisma.payment.update).toHaveBeenCalledWith(expect.objectContaining({
      data: expect.objectContaining({ status: PrismaPaymentStatus.FAILED, resultCode: 1032 }),
    }));
  });

  it('wrong PIN 2001 → FAILED', async () => {
    await svc.handleMpesaCallback({
      Body: { stkCallback: { MerchantRequestID: 'MR_1', CheckoutRequestID: 'ws_CO_123', ResultCode: 2001, ResultDesc: 'Invalid' } },
    });
    expect(prisma.payment.update).toHaveBeenCalledWith(expect.objectContaining({
      data: expect.objectContaining({ status: PrismaPaymentStatus.FAILED, resultCode: 2001 }),
    }));
  });

  it('insufficient funds 1 → FAILED', async () => {
    await svc.handleMpesaCallback({
      Body: { stkCallback: { MerchantRequestID: 'MR_1', CheckoutRequestID: 'ws_CO_123', ResultCode: 1, ResultDesc: 'Insufficient' } },
    });
    expect(prisma.payment.update).toHaveBeenCalledWith(expect.objectContaining({
      data: expect.objectContaining({ status: PrismaPaymentStatus.FAILED, resultCode: 1 }),
    }));
  });

  it('duplicate callback on terminal payment is a no-op', async () => {
    prisma.payment.findUnique.mockResolvedValue({ ...mockPayment, status: PrismaPaymentStatus.SUCCESS });
    await svc.handleMpesaCallback({
      Body: { stkCallback: { CheckoutRequestID: 'ws_CO_123', ResultCode: 0, ResultDesc: 'ok' } },
    });
    expect(prisma.payment.update).not.toHaveBeenCalled();
  });

  it('amount mismatch → FAILED with reason', async () => {
    await svc.handleMpesaCallback({
      Body: { stkCallback: {
        MerchantRequestID: 'MR_1', CheckoutRequestID: 'ws_CO_123', ResultCode: 0, ResultDesc: 'ok',
        CallbackMetadata: { Item: [{ Name: 'Amount', Value: 50 }, { Name: 'MpesaReceiptNumber', Value: 'RCP' }] },
      }},
    });
    expect(prisma.payment.update).toHaveBeenCalledWith(expect.objectContaining({
      data: expect.objectContaining({ status: PrismaPaymentStatus.FAILED, resultDesc: 'Amount mismatch' }),
    }));
  });
});
