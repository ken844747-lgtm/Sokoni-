export default async function sitemap(): Promise<MetadataRoute.Sitemap> {
  const base = process.env.NEXT_PUBLIC_SITE_URL ?? 'http://localhost:3000';
  const staticPaths = ['', '/categories', '/help', '/about', '/terms', '/privacy', '/contact'];
  const entries: MetadataRoute.Sitemap = staticPaths.map((p) => ({
    url: `${base}${p}`,
    lastModified: new Date(),
    changeFrequency: 'weekly',
    priority: p === '' ? 1 : 0.6,
  }));

  try {
    const res = await fetch(`${process.env.NEXT_PUBLIC_API_URL ?? 'http://localhost:4000/api/v1'}/products?perPage=60&status=ACTIVE`, { cache: 'no-store' });
    const json = await res.json();
    const products: any[] = json?.data ?? [];
    for (const p of products) {
      entries.push({ url: `${base}/product/${p.slug}`, lastModified: new Date(p.updatedAt ?? Date.now()), changeFrequency: 'weekly', priority: 0.8 });
    }
  } catch { /* ignore */ }

  return entries;
}
