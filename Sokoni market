import { createHash, randomInt } from 'crypto';
import { ErrorCode, normalizeKenyanPhone } from '@sokoni/shared';
import { PrismaService } from '../prisma/prisma.service';
import { RedisService } from '../redis/redis.service';
import { SmsService } from '../integrations/sms/sms.service';

type OtpPurpose = 'LOGIN' | 'REGISTER' | 'RESET' | 'PHONE_VERIFY';

@Injectable()
export class OtpService {
  constructor(
    private readonly prisma: PrismaService,
    private readonly redis: RedisService,
    private readonly sms: SmsService,
    private readonly config: ConfigService,
  ) {}

  private hash(code: string): string {
    return createHash('sha256').update(code).digest('hex');
  }

  async request(phoneRaw: string, purpose: OtpPurpose = 'LOGIN'): Promise<{ expiresAt: Date }> {
    const phone = normalizeKenyanPhone(phoneRaw);
    if (!phone) throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Invalid phone number' }, HttpStatus.BAD_REQUEST);

    const cooldownKey = `otp:cooldown:${phone}:${purpose}`;
    const existing = await this.redis.client.ttl(cooldownKey);
    if (existing > 0) {
      throw new HttpException(
        { code: ErrorCode.AUTH_OTP_COOLDOWN, message: `Please wait ${existing}s before requesting another code` },
        HttpStatus.TOO_MANY_REQUESTS,
      );
    }

    // Find or create the user (for LOGIN/REGISTER purposes)
    let user = await this.prisma.user.findUnique({ where: { phone } });
    if (!user) {
      if (purpose === 'LOGIN') {
        throw new HttpException({ code: ErrorCode.AUTH_INVALID_CREDENTIALS, message: 'No account for this phone. Please register.' }, HttpStatus.NOT_FOUND);
      }
      user = await this.prisma.user.create({ data: { phone, fullName: 'Sokoni Customer' } });
    }

    const code = String(randomInt(0, 1_000_000)).padStart(6, '0');
    const ttl = this.config.get<number>('OTP_TTL_SECONDS', 300);

    await this.prisma.otpCode.create({
      data: {
        userId: user.id,
        codeHash: this.hash(code),
        purpose,
        expiresAt: new Date(Date.now() + ttl * 1000),
      },
    });

    await this.redis.client.setex(cooldownKey, this.config.get<number>('OTP_RESEND_COOLDOWN_SECONDS', 60), '1');
    await this.sms.send(phone, `Your Sokoni verification code is ${code}. Expires in ${Math.floor(ttl / 60)} minutes.`);

    return { expiresAt: new Date(Date.now() + ttl * 1000) };
  }

  async verify(phoneRaw: string, code: string, purpose: OtpPurpose = 'LOGIN'): Promise<{ userId: string }> {
    const phone = normalizeKenyanPhone(phoneRaw);
    if (!phone) throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Invalid phone number' }, HttpStatus.BAD_REQUEST);

    const user = await this.prisma.user.findUnique({ where: { phone } });
    if (!user) throw new HttpException({ code: ErrorCode.AUTH_OTP_INVALID, message: 'Invalid code' }, HttpStatus.BAD_REQUEST);

    const record = await this.prisma.otpCode.findFirst({
      where: { userId: user.id, purpose, consumedAt: null },
      orderBy: { createdAt: 'desc' },
    });

    if (!record || record.expiresAt < new Date()) {
      throw new HttpException({ code: ErrorCode.AUTH_OTP_EXPIRED, message: 'Code has expired. Request a new one.' }, HttpStatus.BAD_REQUEST);
    }

    const maxAttempts = this.config.get<number>('OTP_MAX_ATTEMPTS', 5);
    if (record.attempts >= maxAttempts) {
      throw new HttpException({ code: ErrorCode.AUTH_OTP_INVALID, message: 'Too many attempts. Request a new code.' }, HttpStatus.BAD_REQUEST);
    }

    if (record.codeHash !== this.hash(code)) {
      await this.prisma.otpCode.update({ where: { id: record.id }, data: { attempts: { increment: 1 } } });
      throw new HttpException({ code: ErrorCode.AUTH_OTP_INVALID, message: 'Incorrect code' }, HttpStatus.BAD_REQUEST);
    }

    await this.prisma.$transaction([
      this.prisma.otpCode.update({ where: { id: record.id }, data: { consumedAt: new Date() } }),
      this.prisma.user.update({ where: { id: user.id }, data: { phoneVerified: true, lastLoginAt: new Date() } }),
    ]);

    return { userId: user.id };
  }
}
import { HttpException, HttpStatus, Injectable, Logger } from '@nestjs/common';
import { PrismaService } from '../prisma/prisma.service';
import { PasswordService } from './password.service';
import { TokensService, TokenPair } from './tokens.service';
import { OtpService } from './otp.service';
import { LoginDto, RegisterDto } from './dto/auth.dto';
import { ErrorCode, normalizeKenyanPhone, Role } from '@sokoni/shared';

export interface SessionUser {
  id: string;
  fullName: string;
  email: string | null;
  phone: string | null;
  role: Role;
  vendorId: string | null;
}

@Injectable()
export class AuthService {
  private readonly logger = new Logger(AuthService.name);

  constructor(
    private readonly prisma: PrismaService,
    private readonly passwords: PasswordService,
    private readonly tokens: TokensService,
    private readonly otp: OtpService,
  ) {}

  private toSession(u: any): SessionUser {
    return {
      id: u.id,
      fullName: u.fullName,
      email: u.email,
      phone: u.phone,
      role: u.role,
      vendorId: u.vendor?.id ?? null,
    };
  }

  async register(dto: RegisterDto): Promise<{ user: SessionUser; pair: TokenPair }> {
    if (!dto.email && !dto.phone) {
      throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Email or phone required' }, HttpStatus.BAD_REQUEST);
    }
    const email = dto.email ?? null;
    const phone = dto.phone ? normalizeKenyanPhone(dto.phone) : null;

    if (dto.email && (await this.prisma.user.findUnique({ where: { email } }))) {
      throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Email already registered' }, HttpStatus.CONFLICT);
    }
    if (phone && (await this.prisma.user.findUnique({ where: { phone } }))) {
      throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Phone already registered' }, HttpStatus.CONFLICT);
    }

    const passwordHash = dto.password ? await this.passwords.hash(dto.password) : null;

    const user = await this.prisma.user.create({
      data: {
        fullName: dto.fullName,
        email,
        phone,
        passwordHash,
        role: dto.role === Role.VENDOR ? Role.VENDOR : Role.CUSTOMER,
        phoneVerified: false,
        emailVerified: false,
      },
      include: { vendor: true },
    });

    const pair = await this.tokens.issuePair(user.id, user.role, user.vendor?.id ?? null);
    return { user: this.toSession(user), pair };
  }

  async login(dto: LoginDto): Promise<{ user: SessionUser; pair: TokenPair }> {
    const email = dto.email ?? null;
    const phone = dto.phone ? normalizeKenyanPhone(dto.phone) : null;
    if (!email && !phone) {
      throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Email or phone required' }, HttpStatus.BAD_REQUEST);
    }
    const user = email
      ? await this.prisma.user.findUnique({ where: { email }, include: { vendor: true } })
      : await this.prisma.user.findUnique({ where: { phone: phone! }, include: { vendor: true } });

    const invalid = () =>
      new HttpException({ code: ErrorCode.AUTH_INVALID_CREDENTIALS, message: 'Invalid credentials' }, HttpStatus.UNAUTHORIZED);

    if (!user || !user.passwordHash) throw invalid();
    if (!user.isActive) throw new HttpException({ code: ErrorCode.AUTH_FORBIDDEN, message: 'Account disabled' }, HttpStatus.FORBIDDEN);
    const ok = await this.passwords.verify(user.passwordHash, dto.password);
    if (!ok) throw invalid();

    await this.prisma.user.update({ where: { id: user.id }, data: { lastLoginAt: new Date() } });
    const pair = await this.tokens.issuePair(user.id, user.role, user.vendor?.id ?? null);
    return { user: this.toSession(user), pair };
  }

  async loginWithOtp(phone: string, code: string): Promise<{ user: SessionUser; pair: TokenPair }> {
    const { userId } = await this.otp.verify(phone, code, 'LOGIN');
    const user = await this.prisma.user.findUniqueOrThrow({ where: { id: userId }, include: { vendor: true } });
    if (!user.isActive) throw new HttpException({ code: ErrorCode.AUTH_FORBIDDEN, message: 'Account disabled' }, HttpStatus.FORBIDDEN);
    const pair = await this.tokens.issuePair(user.id, user.role, user.vendor?.id ?? null);
    return { user: this.toSession(user), pair };
  }

  async refresh(refreshToken: string): Promise<{ user: SessionUser; pair: TokenPair }> {
    const rotated = await this.tokens.rotate(refreshToken);
    if (!rotated) {
      throw new HttpException({ code: ErrorCode.AUTH_UNAUTHORIZED, message: 'Invalid refresh token' }, HttpStatus.UNAUTHORIZED);
    }
    const user = await this.prisma.user.findUniqueOrThrow({ where: { id: rotated.userId }, include: { vendor: true } });
    return { user: this.toSession(user), pair: rotated.pair };
  }

  async logout(refreshToken?: string): Promise<void> {
    if (refreshToken) await this.tokens.revoke(refreshToken);
  }

  async me(userId: string): Promise<SessionUser> {
    const user = await this.prisma.user.findUnique({ where: { id: userId }, include: { vendor: true } });
    if (!user) throw new HttpException({ code: ErrorCode.NOT_FOUND, message: 'User not found' }, HttpStatus.NOT_FOUND);
    return this.toSession(user);
  }
}
import { Injectable } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
