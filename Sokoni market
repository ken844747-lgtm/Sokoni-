}

@Injectable()
export class SearchService implements OnModuleInit {
  private readonly logger = new Logger(SearchService.name);
  private readonly client: MeiliSearch | null;
  private readonly indexName: string;
  private readonly provider: 'meili' | 'postgres';

  constructor(
    private readonly config: ConfigService,
    private readonly prisma: PrismaService,
  ) {
    this.provider = config.get<'meili' | 'postgres'>('SEARCH_PROVIDER', 'meili');
    this.indexName = config.get<string>('MEILI_INDEX_PRODUCTS', 'products');
    this.client =
      this.provider === 'meili'
        ? new MeiliSearch({
            host: config.getOrThrow<string>('MEILI_HOST'),
            apiKey: config.getOrThrow<string>('MEILI_MASTER_KEY'),
          })
        : null;
  }

  async onModuleInit() {
    if (!this.client) {
      this.logger.log('Search provider: postgres (FTS)');
      return;
    }
    try {
      await this.client.createIndex(this.indexName, { primaryKey: 'id' }).catch(() => undefined);
      const index = this.client.index(this.indexName);
      await index.updateSettings({
        searchableAttributes: ['name', 'brand', 'categoryName', 'vendorName', 'description'],
        filterableAttributes: ['status', 'categoryId', 'categorySlug', 'vendorId', 'brand', 'priceCents', 'ratingAvg'],
        sortableAttributes: ['priceCents', 'ratingAvg', 'soldCount', 'createdAt'],
        rankingRules: ['words', 'typo', 'proximity', 'attribute', 'sort', 'exactness'],
        typoTolerance: { enabled: true, minWordSizeForTypos: { oneTypo: 4, twoTypos: 8 } },
      });
      this.logger.log(`Search provider: meilisearch (${this.indexName})`);
    } catch (err) {
      this.logger.warn(`Meilisearch init failed: ${(err as Error).message}`);
    }
  }

  private get index(): Index | null {
    return this.client ? this.client.index(this.indexName) : null;
  }

  async indexProduct(productId: string): Promise<void> {
    const idx = this.index;
    if (!idx) return;
    const p = await this.prisma.product.findUnique({
      where: { id: productId },
      include: { category: true, vendor: true },
    });
    if (!p || p.status !== 'ACTIVE') {
      await idx.deleteDocument(productId).catch(() => undefined);
      return;
    }
    const doc: ProductDoc = {
      id: p.id,
      name: p.name,
      slug: p.slug,
      description: p.description,
      brand: p.brand,
      categoryId: p.categoryId,
      categoryName: p.category.name,
      categorySlug: p.category.slug,
      vendorId: p.vendorId,
      vendorName: p.vendor.storeName,
      priceCents: p.basePriceCents,
      compareAtCents: p.compareAtCents,
      ratingAvg: p.ratingAvg,
      soldCount: p.soldCount,
      images: (p.images as string[]) ?? [],
      status: p.status,
      createdAt: p.createdAt.getTime(),
    };
    await idx.addDocuments([doc]);
  }

  async removeProduct(productId: string): Promise<void> {
    await this.index?.deleteDocument(productId).catch(() => undefined);
  }

  async reindexAll(): Promise<{ indexed: number }> {
    const idx = this.index;
    if (!idx) return { indexed: 0 };
    const products = await this.prisma.product.findMany({
      where: { status: 'ACTIVE' },
      include: { category: true, vendor: true },
    });
    const docs: ProductDoc[] = products.map((p) => ({
      id: p.id,
      name: p.name,
      slug: p.slug,
      description: p.description,
      brand: p.brand,
      categoryId: p.categoryId,
      categoryName: p.category.name,
      categorySlug: p.category.slug,
      vendorId: p.vendorId,
      vendorName: p.vendor.storeName,
      priceCents: p.basePriceCents,
      compareAtCents: p.compareAtCents,
      ratingAvg: p.ratingAvg,
      soldCount: p.soldCount,
      images: (p.images as string[]) ?? [],
      status: p.status,
      createdAt: p.createdAt.getTime(),
    }));
    await idx.deleteAllDocuments();
    if (docs.length) await idx.addDocuments(docs);
    return { indexed: docs.length };
  }

  async search(opts: {
    q: string;
    page?: number;
    perPage?: number;
    categoryId?: string;
    vendorId?: string;
    minPriceCents?: number;
    maxPriceCents?: number;
    brand?: string;
    minRating?: number;
    sort?: 'relevance' | 'price_asc' | 'price_desc' | 'rating' | 'newest' | 'popular';
  }): Promise<{ ids: string[]; total: number; tookMs: number }> {
    const page = opts.page ?? 1;
    const perPage = Math.min(opts.perPage ?? 24, 60);
    const started = Date.now();

    if (this.client) {
      const filters: string[] = ["status = 'ACTIVE'"];
      if (opts.categoryId) filters.push(`categoryId = '${opts.categoryId}'`);
      if (opts.vendorId) filters.push(`vendorId = '${opts.vendorId}'`);
      if (opts.brand) filters.push(`brand = '${opts.brand}'`);
      if (opts.minPriceCents !== undefined) filters.push(`priceCents >= ${opts.minPriceCents}`);
      if (opts.maxPriceCents !== undefined) filters.push(`priceCents <= ${opts.maxPriceCents}`);
      if (opts.minRating !== undefined) filters.push(`ratingAvg >= ${opts.minRating}`);

      const sortMap: Record<string, string[]> = {
        price_asc: ['priceCents:asc'],
        price_desc: ['priceCents:desc'],
        rating: ['ratingAvg:desc'],
        newest: ['createdAt:desc'],
        popular: ['soldCount:desc'],
      };

      const res = await this.client.index(this.indexName).search(opts.q, {
        filter: filters.join(' AND '),
        sort: sortMap[opts.sort ?? ''] ?? undefined,
        limit: perPage,
        offset: (page - 1) * perPage,
        attributesToRetrieve: ['id'],
      });
      return {
        ids: res.hits.map((h: any) => h.id),
        total: res.estimatedTotalHits ?? res.hits.length,
        tookMs: Date.now() - started,
      };
    }

    // Postgres FTS fallback
    const where: any = { status: 'ACTIVE' };
    if (opts.categoryId) where.categoryId = opts.categoryId;
    if (opts.vendorId) where.vendorId = opts.vendorId;
    if (opts.brand) where.brand = opts.brand;
    if (opts.minPriceCents !== undefined || opts.maxPriceCents !== undefined) {
      where.basePriceCents = {};
      if (opts.minPriceCents !== undefined) where.basePriceCents.gte = opts.minPriceCents;
      if (opts.maxPriceCents !== undefined) where.basePriceCents.lte = opts.maxPriceCents;
    }
    if (opts.minRating !== undefined) where.ratingAvg = { gte: opts.minRating };

    if (opts.q && opts.q.trim()) {
      // Postgres full-text using ILIKE for simplicity here; the schema can gain a tsvector index later.
      const term = `%${opts.q.trim().replace(/[%_]/g, '\\$&')}%`;
      where.OR = [
        { name: { contains: opts.q, mode: 'insensitive' } },
        { brand: { contains: opts.q, mode: 'insensitive' } },
        { description: { contains: opts.q, mode: 'insensitive' } },
      ];
      void term;
    }

    const orderBy: any =
      opts.sort === 'price_asc' ? { basePriceCents: 'asc' }
      : opts.sort === 'price_desc' ? { basePriceCents: 'desc' }
      : opts.sort === 'rating' ? { ratingAvg: 'desc' }
      : opts.sort === 'newest' ? { createdAt: 'desc' }
      : opts.sort === 'popular' ? { soldCount: 'desc' }
      : { createdAt: 'desc' };

    const [rows, total] = await Promise.all([
      this.prisma.product.findMany({
        where,
        orderBy,
        select: { id: true },
        skip: (page - 1) * perPage,
        take: perPage,
      }),
      this.prisma.product.count({ where }),
    ]);
    return { ids: rows.map((r) => r.id), total, tookMs: Date.now() - started };
  }

  async suggest(q: string, limit = 8): Promise<Array<{ text: string; slug: string }>> {
    if (!q || q.trim().length < 2) return [];
    if (this.client) {
      const res = await this.client.index(this.indexName).search(q, {
        limit,
        attributesToRetrieve: ['name', 'slug'],
        filter: ["status = 'ACTIVE'"],
      });
      return res.hits.map((h: any) => ({ text: h.name, slug: h.slug }));
    }
    const rows = await this.prisma.product.findMany({
      where: { status: 'ACTIVE', name: { contains: q, mode: 'insensitive' } },
      select: { name: true, slug: true },
      take: limit,
    });
    return rows.map((r) => ({ text: r.name, slug: r.slug }));
  }
}
