interface AuthResponse { user: SessionUser }

export function LoginForm() {
  const router = useRouter();
  const next = useSearchParams().get('next') ?? '/account';
  const setUser = useAuthStore((s) => s.setUser);

  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [phone, setPhone] = useState('');
  const [otp, setOtp] = useState('');
  const [otpSent, setOtpSent] = useState(false);

  const login = useMutation({
    mutationFn: () => api.post<AuthResponse>('/auth/login', { email, password }),
    onSuccess: (res) => { setUser(res.user); router.push(next); },
    onError: (e: Error) => toast({ title: 'Sign in failed', description: e.message, variant: 'destructive' }),
  });

  const requestOtp = useMutation({
    mutationFn: () => api.post('/auth/otp/request', { phone, purpose: 'LOGIN' }),
    onSuccess: () => { setOtpSent(true); toast({ title: 'Code sent', description: 'Check your SMS.', variant: 'success' }); },
    onError: (e: Error) => toast({ title: 'Could not send', description: e.message, variant: 'destructive' }),
  });

  const verifyOtp = useMutation({
