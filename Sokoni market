name: sokoni

services:
  postgres:
    image: postgres:16-alpine
    container_name: sokoni-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: sokoni
      POSTGRES_PASSWORD: sokoni_dev_pw
      POSTGRES_DB: sokoni
    ports: ["5432:5432"]
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U sokoni -d sokoni"]
      interval: 5s
      timeout: 5s
      retries: 20

  redis:
    image: redis:7-alpine
    container_name: sokoni-redis
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes", "--maxmemory-policy", "noeviction"]
    ports: ["6379:6379"]
    volumes:
      - redisdata:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 20

  meilisearch:
    image: getmeili/meilisearch:v1.8
    container_name: sokoni-meili
    restart: unless-stopped
    environment:
      MEILI_MASTER_KEY: sokoni_meili_dev_master_key
      MEILI_ENV: development
      MEILI_NO_ANALYTICS: "true"
    ports: ["7700:7700"]
    volumes:
      - meilidata:/meili_data
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:7700/health"]
      interval: 5s
      timeout: 3s
      retries: 20

  minio:
    image: minio/minio:RELEASE.2024-05-10T01-41-38Z
    container_name: sokoni-minio
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: sokoni_minio
      MINIO_ROOT_PASSWORD: sokoni_minio_secret
    ports:
      - "9000:9000"
      - "9001:9001"
    volumes:
      - miniodata:/data
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 5s
      timeout: 5s
      retries: 20

  minio-init:
    image: minio/mc:RELEASE.2024-05-09T17-04-24Z
    container_name: sokoni-minio-init
    depends_on:
      minio:
        condition: service_healthy
    entrypoint: >
      /bin/sh -c "
      mc alias set local http://minio:9000 sokoni_minio sokoni_minio_secret &&
      mc mb -p local/sokoni-products &&
      mc anonymous set download local/sokoni-products &&
      echo 'MinIO ready';
      "

  api:
    build:
      context: .
      dockerfile: apps/api/Dockerfile.dev
    container_name: sokoni-api
    restart: unless-stopped
    env_file: [.env]
    environment:
      DATABASE_URL: postgresql://sokoni:sokoni_dev_pw@postgres:5432/sokoni?schema=public
      REDIS_URL: redis://redis:6379
      MEILI_HOST: http://meilisearch:7700
      S3_ENDPOINT: http://minio:9000
    depends_on:
      postgres: { condition: service_healthy }
      redis: { condition: service_healthy }
      meilisearch: { condition: service_healthy }
      minio: { condition: service_healthy }
    ports: ["4000:4000"]
    volumes:
      - ./apps/api:/app/apps/api
      - ./packages/shared:/app/packages/shared
      - /app/apps/api/node_modules
      - /app/node_modules
    command: pnpm --filter @sokoni/api dev

  web:
    build:
      context: .
      dockerfile: apps/web/Dockerfile.dev
    container_name: sokoni-web
    restart: unless-stopped
    env_file: [.env]
    environment:
      NEXT_PUBLIC_API_URL: http://localhost:4000/api/v1
    depends_on: [api]
    ports: ["3000:3000"]
    volumes:
      - ./apps/web:/app/apps/web
      - ./packages/shared:/app/packages/shared
      - /app/apps/web/node_modules
      - /app/apps/web/.next
      - /app/node_modules
    command: pnpm --filter @sokoni/web dev

volumes:
  pgdata:
  redisdata:
  meilidata:
  miniodata:
