export const ORDER_NUMBER_PREFIX = 'SK';
export const ORDER_NUMBER_LENGTH = 10; // SK + 8 chars
export const OTP_LENGTH = 6;
export const OTP_TTL_SECONDS = 300;
export const OTP_MAX_ATTEMPTS = 5;
export const OTP_RESEND_COOLDOWN_SECONDS = 60;
export const STK_PUSH_COOLDOWN_SECONDS = 120;
export const STOCK_RESERVATION_MINUTES = 15;
// Sokoni Prisma schema
// All money stored as INTEGER CENTS of KES (1 KES = 100 cents).
// All timestamps UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum Role { CUSTOMER VENDOR ADMIN SUPPORT }
enum VendorStatus { PENDING APPROVED SUSPENDED REJECTED }
enum ProductStatus { DRAFT ACTIVE ARCHIVED }
enum OrderStatus {
  PENDING_PAYMENT PAID PROCESSING SHIPPED DELIVERED
  RETURNED REFUNDED CANCELLED EXPIRED
}
enum PaymentProvider { MPESA_STK MPESA_C2B FLUTTERWAVE POD WALLET }
enum PaymentStatus { PENDING SUCCESS FAILED EXPIRED REFUNDED PARTIALLY_REFUNDED }
enum RefundStatus { REQUESTED APPROVED PROCESSING SUCCESS FAILED REJECTED }
enum ShipmentStatus { PENDING PICKED_UP IN_TRANSIT OUT_FOR_DELIVERY DELIVERED FAILED RETURNED }
enum DeliveryMethod { DOOR PICKUP }
enum PayoutStatus { PENDING PROCESSING PAID FAILED }
enum NotificationChannel { IN_APP SMS EMAIL PUSH }
enum WalletTxType { CREDIT DEBIT }

// ─── Users & Auth ─────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String?   @unique
  phone          String?   @unique
  passwordHash   String?
  fullName       String
  role           Role      @default(CUSTOMER)
  emailVerified  Boolean   @default(false)
  phoneVerified  Boolean   @default(false)
  avatarUrl      String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?

  vendor         Vendor?
  addresses      Address[]
  carts          Cart[]
  orders         Order[]
  reviews        Review[]
  questions      Question[]
  answers        Answer[]
  wishlist       WishlistItem[]
  notifications  Notification[]
  wallet         Wallet?
  refreshTokens  RefreshToken[]
  otpCodes       OtpCode[]
  payoutRequests Payout[]               @relation("VendorPayoutRequests")
  auditLogs      AuditLog[]             @relation("ActorLogs")

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([role])
  @@index([createdAt])
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  familyId    String
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model OtpCode {
  id          String   @id @default(cuid())
  userId      String
  codeHash    String
  purpose     String   // LOGIN | REGISTER | RESET | PHONE_VERIFY
  attempts    Int      @default(0)
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// ─── Vendors ──────────────────────────────────────────────────────────────

model Vendor {
  id              String       @id @default(cuid())
  userId          String       @unique
  slug            String       @unique
  storeName       String
  description     String?
  logoUrl         String?
  bannerUrl       String?
  countyCode      Int?
  phone           String?
  email           String?
  status          VendorStatus @default(PENDING)
  rejectionReason String?
  ratingAvg       Float        @default(0)
  ratingCount     Int          @default(0)
  commissionBps   Int          @default(1000)  // 10% in basis points
  payoutMethod    String?      // MPESA_B2C | BANK
  payoutPhone     String?
  approvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  payouts   Payout[]

  @@index([status])
}

// ─── Addresses & Pickup ───────────────────────────────────────────────────

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String?  // Home | Work
  fullName    String
  phone       String
  countyCode  Int
  countyName  String
  town        String
  line1       String
  line2       String?
  landmark    String?
  postalCode  String?
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PickupStation {
  id         String   @id @default(cuid())
  name       String
  countyCode Int
  countyName String
  town       String
  address    String
  phone      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([countyCode])
}

// ─── Categories, Products, Variants, Inventory ────────────────────────────

model Category {
  id          String   @id @default(cuid())
  parentId    String?
  slug        String   @unique
  name        String
  description String?
  iconKey     String?  // shadcn icon key or S3 key
  imageUrl    String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([slug])
}

model Product {
  id            String        @id @default(cuid())
  vendorId      String
  categoryId    String
  slug          String        @unique
  name          String
  description   String        @db.Text
  brand         String?
  images        Json          @default("[]")  // string[]
  basePriceCents Int
  compareAtCents Int?                        // original price for "was"
  currency      String        @default("KES")
  status        ProductStatus @default(DRAFT)
  isFeatured    Boolean       @default(false)
  ratingAvg     Float         @default(0)
  ratingCount   Int           @default(0)
  soldCount     Int           @default(0)
  attributes    Json          @default("{}") // { size: [...], color: [...] }
  metaTitle     String?
  metaDescription String?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  vendor    Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id])
  variants  Variant[]
  reviews   Review[]
  questions Question[]
  wishlist  WishlistItem[]
  orderItems OrderItem[]
  flashSaleItems FlashSaleItem[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([status, isFeatured])
  @@index([slug])
}

model Variant {
  id             String   @id @default(cuid())
  productId      String
  sku            String   @unique
  name           String   // e.g. "Size: M / Color: Black"
  optionValues   Json     @default("{}") // { size: "M", color: "Black" }
  priceCents     Int
  compareAtCents Int?
  imageUrl       String?
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model Inventory {
  id            String   @id @default(cuid())
  variantId     String   @unique
  quantity      Int      @default(0)
  reservedQty   Int      @default(0)
  reservedUntil DateTime?
  lowStockAt    Int      @default(5)
  updatedAt     DateTime @updatedAt

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

// ─── Cart & Wishlist ──────────────────────────────────────────────────────

model Cart {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String?  @unique  // guest cart
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  variantId  String
  quantity   Int
  savedForLater Boolean @default(false)
  addedAt    DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ─── Orders ───────────────────────────────────────────────────────────────

model Order {
  id                String       @id @default(cuid())
  orderNumber       String       @unique
  userId            String
  status            OrderStatus  @default(PENDING_PAYMENT)
  subtotalCents     Int
  deliveryFeeCents  Int          @default(0)
  discountCents     Int          @default(0)
  totalCents        Int
  currency          String       @default("KES")

  deliveryMethod    DeliveryMethod
  countyCode        Int
  countyName        String
  town              String
  addressLine1      String?
  addressLine2      String?
  landmark          String?
  pickupStationId   String?
  contactName       String
  contactPhone      String
  customerNote      String?

  couponCode        String?
  expiresAt         DateTime?    // stock reservation expiry

  paidAt            DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  refunds       Refund[]
  shipment      Shipment?
  events        OrderEvent[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  variantId      String
  vendorId       String
  productName    String
  variantName    String
  sku            String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  imageUrl       String?
  commissionBps  Int      @default(1000)
  commissionCents Int     @default(0)
  vendorEarningCents Int  @default(0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  variant Variant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([vendorId])
}

model OrderEvent {
  id         String      @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  actorRole  String?
  note       String?
  createdAt  DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ─── Payments, Refunds, Shipments, Payouts ────────────────────────────────

model Payment {
  id                  String          @id @default(cuid())
  orderId             String
  provider            PaymentProvider
  status              PaymentStatus   @default(PENDING)
  amountCents         Int
  currency            String          @default("KES")

  merchantRequestId   String?
  checkoutRequestId   String?         @unique
  mpesaReceipt        String?         @unique
  providerRef         String?         // Flutterwave tx_ref
  providerTxId        String?         // Flutterwave transaction_id
  phone               String?
  accountReference    String?
  resultCode          Int?
  resultDesc          String?
  rawPayload          Json?
  failureReason       String?

  idempotencyKey      String?         @unique
  initiatedAt         DateTime        @default(now())
  completedAt         DateTime?
  expiresAt           DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([provider, status])
  @@index([createdAt])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  signature   String?
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, createdAt])
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  paymentId       String?
  amountCents     Int
  reason          String
  status          RefundStatus @default(REQUESTED)
  requestedById   String?
  approvedById    String?
  provider        PaymentProvider
  providerRef     String?
  providerTxId    String?
  rawPayload      Json?
  failureReason   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  completedAt     DateTime?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@index([status])
}

model Shipment {
  id              String         @id @default(cuid())
  orderId         String         @unique
  status          ShipmentStatus @default(PENDING)
  courier         String?
  trackingNumber  String?
  estimatedDate   DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  events          Json           @default("[]") // [{ at, status, note }]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payout {
  id              String       @id @default(cuid())
  vendorId        String
  amountCents     Int
  status          PayoutStatus @default(PENDING)
  periodStart     DateTime
  periodEnd       DateTime
  providerRef     String?
  providerTxId    String?
  failureReason   String?
  requestedById   String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  vendor      Vendor @relation(fields: [vendorId], references: [id])
  requestedBy User?  @relation("VendorPayoutRequests", fields: [requestedById], references: [id])

  @@index([vendorId, status])
}

// ─── Reviews, Q&A ─────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  orderId    String?
  rating     Int      // 1..5
  title      String?
  body       String   @db.Text
  images     Json     @default("[]")
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(true)
  helpfulCount Int    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies ReviewReply[]

  @@unique([productId, userId, orderId])
  @@index([productId, isApproved])
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  body      String   @db.Text
  isVendor  Boolean  @default(false)
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model Question {
  id        String   @id @default(cuid())
  productId String
  userId    String
  body      String   @db.Text
  isAnswered Boolean @default(false)
  createdAt DateTime @default(now())

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([productId, isAnswered])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  body       String   @db.Text
  isVendor   Boolean  @default(false)
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// ─── Coupons, Flash Sales, Banners ────────────────────────────────────────

model Coupon {
  id               String   @id @default(cuid())
  code             String   @unique
  description      String?
  type             String   // PERCENT | FIXED
  value            Int      // percent 1-100 | cents
  minSubtotalCents Int      @default(0)
  maxDiscountCents Int?
  usageLimit       Int?
  usedCount        Int      @default(0)
  perUserLimit     Int      @default(1)
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([code, isActive])
}

model FlashSale {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(true)
  bannerUrl String?
  createdAt DateTime @default(now())

  items FlashSaleItem[]

  @@index([startsAt, endsAt, isActive])
}

model FlashSaleItem {
  id              String   @id @default(cuid())
  flashSaleId     String
  productId       String
  discountPercent Int
  stockLimit      Int?
  soldCount       Int      @default(0)

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, productId])
}

model Banner {
  id         String   @id @default(cuid())
  title      String?
  subtitle   String?
  imageUrl   String
  ctaLabel   String?
  ctaUrl     String?
  placement  String   @default("HOME_HERO") // HOME_HERO | HOME_STRIP | CATEGORY
  position   Int      @default(0)
  isActive   Boolean  @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([placement, isActive, position])
}

// ─── Notifications & Wallet ───────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  data      Json                @default("{}")
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  balanceCents Int     @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String       @id @default(cuid())
  walletId    String
  type        WalletTxType
  amountCents Int
  balanceAfter Int
  reason      String
  refId       String?
  createdAt   DateTime     @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

// ─── Audit & Idempotency ──────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  entity     String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("ActorLogs", fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  key         String
  scope       String   // STK_PUSH | REFUND | PAYOUT
  responseData Json?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([key, scope])
  @@index([expiresAt])
}
