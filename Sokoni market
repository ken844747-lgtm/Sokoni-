@Injectable()
export class PayoutsService {
  constructor(private readonly prisma: PrismaService, private readonly audit: AuditService) {}

  async balance(vendorId: string) {
    const earned = await this.prisma.orderItem.aggregate({
      where: { vendorId, order: { status: { in: ['PAID', 'PROCESSING', 'SHIPPED', 'DELIVERED'] } } },
      _sum: { vendorEarningCents: true },
    });
    const paid = await this.prisma.payout.aggregate({
      where: { vendorId, status: PayoutStatus.PAID },
      _sum: { amountCents: true },
    });
    const inFlight = await this.prisma.payout.aggregate({
      where: { vendorId, status: { in: [PayoutStatus.PENDING, PayoutStatus.PROCESSING] } },
      _sum: { amountCents: true },
    });
    return {
      earnedCents: earned._sum.vendorEarningCents ?? 0,
      paidCents: paid._sum.amountCents ?? 0,
      pendingCents: inFlight._sum.amountCents ?? 0,
      availableCents: (earned._sum.vendorEarningCents ?? 0) - (paid._sum.amountCents ?? 0) - (inFlight._sum.amountCents ?? 0),
    };
  }

  async listMine(vendorId: string) {
    return this.prisma.payout.findMany({ where: { vendorId }, orderBy: { createdAt: 'desc' }, take: 50 });
  }

  async request(vendorId: string, amountCents: number) {
    const bal = await this.balance(vendorId);
    if (amountCents <= 0 || amountCents > bal.availableCents) {
      throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: `Amount exceeds available balance (${bal.availableCents})` }, HttpStatus.BAD_REQUEST);
    }
    return this.prisma.payout.create({
      data: {
        vendorId,
        amountCents,
        periodStart: new Date(Date.now() - 30 * 86400_000),
        periodEnd: new Date(),
        status: PayoutStatus.PENDING,
      },
    });
  }

  async listAdmin(opts: { status?: PayoutStatus; page?: number; perPage?: number } = {}) {
    const page = opts.page ?? 1;
    const perPage = Math.min(opts.perPage ?? 30, 100);
    const where: any = opts.status ? { status: opts.status } : {};
    const [rows, total] = await Promise.all([
      this.prisma.payout.findMany({ where, orderBy: { createdAt: 'desc' }, include: { vendor: { select: { storeName: true } } }, skip: (page - 1) * perPage, take: perPage }),
      this.prisma.payout.count({ where }),
    ]);
    return { data: rows, meta: { page, perPage, total, totalPages: Math.max(1, Math.ceil(total / perPage)) } };
  }

  async mark(adminId: string, id: string, status: PayoutStatus, providerRef?: string) {
    const p = await this.prisma.payout.findUnique({ where: { id } });
    if (!p) throw new HttpException({ code: ErrorCode.NOT_FOUND, message: 'Payout not found' }, HttpStatus.NOT_FOUND);
    const updated = await this.prisma.payout.update({
      where: { id },
      data: { status, providerRef, processedAt: status === PayoutStatus.PAID ? new Date() : p.processedAt, requestedById: adminId },
    });
    await this.audit.record({ actorId: adminId, action: `PAYOUT_${status}`, entity: 'Payout', entityId: id, before: { status: p.status }, after: { status } });
    return updated;
  }
}
