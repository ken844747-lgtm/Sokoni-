'use client';
import { useEffect, useState } from 'react';

export function useCountdown(targetIso: string) {
  const [remaining, setRemaining] = useState(() => Math.max(0, new Date(targetIso).getTime() - Date.now()));
  useEffect(() => {
    const t = setInterval(() => setRemaining(Math.max(0, new Date(targetIso).getTime() - Date.now())), 1000);
    return () => clearInterval(t);
  }, [targetIso]);
  const s = Math.floor(remaining / 1000);
  return {
    days: Math.floor(s / 86400),
    hours: Math.floor((s % 86400) / 3600),
    minutes: Math.floor((s % 3600) / 60),
    seconds: s % 60,
    expired: remaining === 0,
  };
}

export function Countdown({ endsAt }: { endsAt: string }) {
  const c = useCountdown(endsAt);
  if (c.expired) return <span className="text-xs font-medium text-red-600">Sale ended</span>;
  return (
    <span className="inline-flex items-center gap-1 text-xs font-medium">
      <Unit v={c.hours} label="h" /> : <Unit v={c.minutes} label="m" /> : <Unit v={c.seconds} label="s" />
    </span>
  );
}

function Unit({ v, label }: { v: number; label: string }) {
  return <span className="rounded bg-brand-ink px-1.5 py-0.5 font-mono text-white">{String(v).padStart(2, '0')}{label}</span>;
}
