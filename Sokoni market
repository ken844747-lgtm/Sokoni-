export function ProductForm({ onDone }: { onDone: () => void }) {
  const cats = useQuery({ queryKey: ['categories'], queryFn: () => api.get<any[]>('/categories') });
  const [name, setName] = useState(''); const [desc, setDesc] = useState('');
  const [categoryId, setCategoryId] = useState(''); const [brand, setBrand] = useState('');
  const [price, setPrice] = useState(''); const [compare, setCompare] = useState('');
  const [images, setImages] = useState(''); const [sku, setSku] = useState(''); const [qty, setQty] = useState('0');

  const create = useMutation({
    mutationFn: () => api.post('/products', {
      name, description: desc, categoryId, brand,
      images: images.split('|').map((s) => s.trim()).filter(Boolean),
      basePriceCents: Math.round(Number(price) * 100),
      compareAtCents: compare ? Math.round(Number(compare) * 100) : undefined,
      status: 'ACTIVE',
      variants: [{ sku, name: 'Standard', priceCents: Math.round(Number(price) * 100), quantity: Number(qty) }],
    }),
    onSuccess: () => { toast({ title: 'Product created', variant: 'success' }); onDone(); },
    onError: (e: Error) => toast({ title: 'Failed', description: e.message, variant: 'destructive' }),
  });

  const flat = (cats.data ?? []).flatMap((c: any) => c.children?.length ? c.children : [c]);

  return (
    <div className="rounded-lg border bg-white p-4">
