@ApiTags('admin-payments')
@Controller('admin/payments')
@UseGuards(JwtAuthGuard, RolesGuard)
@Roles(Role.ADMIN)
export class ReconciliationController {
  constructor(private readonly prisma: PrismaService) {}

  @Get()
  async list(@Query('status') status?: PaymentStatus, @Query('q') q?: string, @Query('page') page = '1') {
    const p = Math.max(1, Number(page));
    const perPage = 30;
    const where: any = {};
    if (status) where.status = status;
    if (q) where.OR = [{ mpesaReceipt: { contains: q } }, { checkoutRequestId: { contains: q } }, { phone: { contains: q } }];
    const [rows, total] = await Promise.all([
      this.prisma.payment.findMany({ where, include: { order: { select: { orderNumber: true, totalCents: true } } }, orderBy: { createdAt: 'desc' }, skip: (p - 1) * perPage, take: perPage }),
      this.prisma.payment.count({ where }),
    ]);
    return { data: rows, meta: { page: p, perPage, total, totalPages: Math.max(1, Math.ceil(total / perPage)) } };
  }

  @Get('unmatched')
  unmatched() {
    return this.prisma.payment.findMany({
      where: { status: 'SUCCESS', orderId: undefined as any },
      take: 100,
    }).catch(() => this.prisma.payment.findMany({ where: { status: 'SUCCESS' }, take: 100 }));
  }
}
