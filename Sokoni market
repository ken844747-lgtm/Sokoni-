'use client';
import { useRouter, useSearchParams } from 'next/navigation';
import { useEffect, useState } from 'react';
import { useMutation, useQuery } from '@tanstack/react-query';
import { api } from '@/lib/api-client';
import { formatPrice } from '@/lib/format';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { useAuthStore } from '@/stores/auth-store';
import { toast } from '@/components/ui/toast';
import { MpesaWaiting } from './mpesa-waiting';

interface Order { id: string; orderNumber: string; totalCents: number; status: string }

export function PaymentRouter({ orderId, initialMethod }: { orderId: string; initialMethod: string }) {
  const method = useSearchParams().get('method') ?? initialMethod;
  const user = useAuthStore((s) => s.user);
  const [phone, setPhone] = useState(user?.phone ?? '0701187557');
  const [checkoutId, setCheckoutId] = useState<string | null>(null);

  const order = useQuery({
    queryKey: ['order', orderId],
    queryFn: () => api.get<Order>(`/orders/${orderId}`),
    refetchInterval: (q) => (q.state.data?.status === 'PENDING_PAYMENT' ? 4000 : false),
  });

  const stk = useMutation({
    mutationFn: () => api.post<{ payment: { id: string; checkoutRequestId: string }; customerMessage: string }>('/payments/mpesa/stk-push', { orderId, phone }),
    onSuccess: (res) => setCheckoutId(res.payment.checkoutRequestId),
    onError: (e: Error) => toast({ title: 'STK push failed', description: e.message, variant: 'destructive' }),
  });

  const card = useMutation({
    mutationFn: () => api.post<{ checkoutUrl: string }>('/payments/flutterwave/initiate', { orderId }),
    onSuccess: (res) => { window.location.href = res.checkoutUrl; },
    onError: (e: Error) => toast({ title: 'Card payment unavailable', description: e.message, variant: 'destructive' }),
  });

  const pod = useMutation({
    mutationFn: () => api.post('/payments/pod/initiate', { orderId }),
    onSuccess: () => { toast({ title: 'Order confirmed', description: 'Pay on delivery.', variant: 'success' }); window.location.href = `/account/orders/${orderId}`; },
    onError: (e: Error) => toast({ title: 'Could not confirm', description: e.message, variant: 'destructive' }),
  });

  if (checkoutId) return <MpesaWaiting orderId={orderId} checkoutId={checkoutId} />;
  if (order.isLoading) return <div className="container-tight py-10 text-center text-sm text-muted-foreground">Loading…</div>;
  if (!order.data) return <div className="container-tight py-10 text-center text-sm text-muted-foreground">Order not found.</div>;
  if (order.data.status !== 'PENDING_PAYMENT') {
    return (
      <div className="container-tight py-10 text-center">
        <p className="text-sm">Order {order.data.orderNumber} is <span className="font-semibold">{order.data.status}</span>.</p>
        <a href={`/account/orders/${orderId}`} className="mt-3 inline-block"><Button>View order</Button></a>
      </div>
    );
  }

  return (
    <div className="container-tight max-w-lg py-6">
      <h1 className="text-xl font-bold">Pay {formatPrice(order.data.totalCents)}</h1>
      <p className="mt-1 text-sm text-muted-foreground">Order {order.data.orderNumber}</p>

      {method === 'mpesa' && (
        <div className="mt-6 rounded-lg border bg-white p-4">
          <h2 className="font-semibold">M-Pesa (Lipa na M-Pesa)</h2>
          <p className="mt-1 text-sm text-muted-foreground">Enter the Safaricom number to receive the STK prompt.</p>
          <div className="mt-3">
            <Label>Phone</Label>
            <Input value={phone} onChange={(e) => setPhone(e.target.value)} placeholder="07XX XXX XXX" />
          </div>
          <Button className="mt-3 w-full" onClick={() => stk.mutate()} disabled={stk.isPending}>
            {stk.isPending ? 'Sending prompt…' : 'Pay with M-Pesa'}
          </Button>
          <p className="mt-2 text-xs text-muted-foreground">You will receive a prompt on your phone. Enter your M-Pesa PIN to confirm.</p>
        </div>
      )}

      {method === 'card' && (
        <div className="mt-6 rounded-lg border bg-white p-4">
          <h2 className="font-semibold">Card payment</h2>
          <p className="mt-1 text-sm text-muted-foreground">You will be redirected to Flutterwave to complete payment securely.</p>
          <Button className="mt-3 w-full" onClick={() => card.mutate()} disabled={card.isPending}>
            {card.isPending ? 'Redirecting…' : 'Pay with card'}
          </Button>
        </div>
      )}

      {method === 'pod' && (
        <div className="mt-6 rounded-lg border bg-white p-4">
          <h2 className="font-semibold">Pay on delivery</h2>
          <p className="mt-1 text-sm text-muted-foreground">Pay the courier in cash or M-Pesa when your order arrives.</p>
          <Button className="mt-3 w-full" onClick={() => pod.mutate()} disabled={pod.isPending}>
            {pod.isPending ? 'Confirming…' : 'Confirm order'}
          </Button>
        </div>
      )}
    </div>
  );
}
'use client';
import { useEffect, useState } from 'react';
import { useRouter } from 'next/navigation';
import { useQuery } from '@tanstack/react-query';
import { Loader2, CheckCircle2, XCircle, Smartphone } from 'lucide-react';
import { api } from '@/lib/api-client';
import { Button } from '@/components/ui/button';
import { useAuthStore } from '@/stores/auth-store';

interface PaymentView { id: string; status: 'PENDING' | 'SUCCESS' | 'FAILED' | 'EXPIRED'; failureReason?: string | null; mpesaReceipt?: string | null }
interface Order { id: string; status: string; orderNumber: string }

const TIMEOUT_MS = 90_000;

export function MpesaWaiting({ orderId, checkoutId }: { orderId: string; checkoutId: string }) {
  const router = useRouter();
  const user = useAuthStore((s) => s.user);
  const [elapsed, setElapsed] = useState(0);
  const [timedOut, setTimedOut] = useState(false);

  // Poll order status — payment success flips order to PAID server-side
  const order = useQuery({
    queryKey: ['order', orderId],
    queryFn: () => api.get<Order>(`/orders/${orderId}`),
    refetchInterval: (q) => (q.state.data?.status === 'PENDING_PAYMENT' ? 2000 : false),
  });

  // Poll payments for this order for granular status
  const payment = useQuery({
    queryKey: ['payment-for-order', orderId, checkoutId],
    queryFn: async () => {
      const all = await api.get<{ payments: PaymentView[] }>(`/orders/${orderId}`);
      return (all as any).payments?.find((p: PaymentView) => p.id) ?? null;
    },
    enabled: false,
  });

  useEffect(() => {
    const t = setInterval(() => setElapsed((e) => e + 1), 1000);
    const timeout = setTimeout(() => setTimedOut(true), TIMEOUT_MS);
    return () => { clearInterval(t); clearTimeout(timeout); };
  }, []);

  useEffect(() => {
    if (order.data?.status === 'PAID' || order.data?.status === 'PROCESSING') {
      router.push(`/account/orders/${orderId}?paid=1`);
    }
  }, [order.data?.status, orderId, router]);

  const isMock = process.env.NEXT_PUBLIC_API_URL?.includes('localhost') ?? false;
  const [mockLoading, setMockLoading] = useState<string | null>(null);

  async function mockOutcome(outcome: 'succeed' | 'fail' | 'cancel') {
    setMockLoading(outcome);
    try {
      await fetch(`${process.env.NEXT_PUBLIC_API_URL}/payments/mpesa/mock/${checkoutId}/${outcome}`, { method: 'POST' });
    } finally {
      setMockLoading(null);
    }
  }

  return (
    <div className="container-tight max-w-lg py-10 text-center">
      <div className="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-brand-green/10">
        <Smartphone className="h-8 w-8 text-brand-green" />
      </div>
      <h1 className="text-xl font-bold">Check your phone</h1>
      <p className="mt-2 text-sm text-muted-foreground">
        A payment prompt has been sent to your phone. Enter your M-Pesa PIN to confirm the payment of your order.
      </p>
      <p className="mt-3 inline-flex items-center gap-2 rounded bg-muted px-3 py-1.5 text-xs font-medium">
        <Loader2 className="h-3 w-3 animate-spin" />
        Waiting for confirmation… ({Math.floor(elapsed / 60)}:{String(elapsed % 60).padStart(2, '0')})
      </p>

      {isMock && (
        <div className="mt-6 rounded-lg border border-dashed bg-amber-50 p-3 text-xs">
          <p className="mb-2 font-semibold text-amber-900">Mock mode — simulate the customer action</p>
          <div className="flex justify-center gap-2">
            <Button size="sm" onClick={() => mockOutcome('succeed')} disabled={!!mockLoading}>
              {mockLoading === 'succeed' ? <Loader2 className="h-3 w-3 animate-spin" /> : <CheckCircle2 className="h-3 w-3" />}
              <span className="ml-1">Succeed</span>
            </Button>
            <Button size="sm" variant="outline" onClick={() => mockOutcome('fail')} disabled={!!mockLoading}>
              <XCircle className="h-3 w-3" /><span className="ml-1">Fail</span>
            </Button>
            <Button size="sm" variant="outline" onClick={() => mockOutcome('cancel')} disabled={!!mockLoading}>Cancel</Button>
          </div>
        </div>
      )}

      {timedOut && (
        <div className="mt-6 rounded-lg border bg-white p-4 text-left text-sm">
          <p className="font-medium">Still waiting?</p>
          <p className="mt-1 text-muted-foreground">It usually takes under a minute. If you didn&apos;t get the prompt, try again.</p>
          <div className="mt-3 flex gap-2">
            <Button onClick={() => router.push(`/checkout/pay/${orderId}?method=mpesa`)}>Retry</Button>
            <Button variant="outline" onClick={() => router.push(`/account/orders/${orderId}`)}>View order</Button>
          </div>
        </div>
      )}

      <p className="mt-6 text-xs text-muted-foreground">
        Never share your M-Pesa PIN. Safaricom will not ask for it on the prompt — only for the PIN you enter yourself.
      </p>
    </div>
  );
}
'use client';
import { useEffect } from 'react';
import { useRouter, useSearchParams } from 'next/navigation';

export default function FlutterwaveCallbackPage() {
  const router = useRouter();
  const sp = useSearchParams();
  useEffect(() => {
    const order = sp.get('order');
    // Flutterwave appends tx_ref / status / transaction_id
    const status = sp.get('status');
    if (order && status === 'successful') router.replace(`/account/orders?paid=1`);
    else if (order) router.replace(`/account/orders`);
  }, [router, sp]);
  return <div className="container-tight py-10 text-center text-sm text-muted-foreground">Finishing payment…</div>;
}
