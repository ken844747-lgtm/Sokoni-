import Link from 'next/link';
import { useRouter } from 'next/navigation';
import { useState } from 'react';
import { useMutation, useQuery } from '@tanstack/react-query';
import { COUNTIES, DeliveryMethod } from '@sokoni/shared';
import { api } from '@/lib/api-client';
import { formatPrice } from '@/lib/format';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { useCartStore } from '@/stores/cart-store';
import { useAuthStore } from '@/stores/auth-store';
import { toast } from '@/components/ui/toast';

interface Address { id: string; label: string | null; fullName: string; phone: string; countyCode: number; countyName: string; town: string; line1: string; isDefault: boolean }
interface Quote { feeCents: number; etaDays: string; zone: string; freeDeliveryApplied: boolean }
interface Order { id: string; orderNumber: string; totalCents: number; status: string }

type Step = 1 | 2 | 3 | 4;

export function CheckoutFlow() {
  const router = useRouter();
  const user = useAuthStore((s) => s.user);
  const { cart, setCart } = useCartStore();

  const [step, setStep] = useState<Step>(1);
  const [addressId, setAddressId] = useState<string | null>(null);
  const [contactName, setContactName] = useState(user?.fullName ?? '');
  const [contactPhone, setContactPhone] = useState(user?.phone ?? '');
  const [countyCode, setCountyCode] = useState<number>(47);
  const [town, setTown] = useState('Nairobi');
  const [line1, setLine1] = useState('');
  const [landmark, setLandmark] = useState('');
  const [deliveryMethod, setDeliveryMethod] = useState<DeliveryMethod>(DeliveryMethod.DOOR);
  const [pickupStationId, setPickupStationId] = useState<string | undefined>();
  const [couponCode, setCouponCode] = useState('');
  const [order, setOrder] = useState<Order | null>(null);

  const addresses = useQuery({
    queryKey: ['addresses'],
    queryFn: () => api.get<Address[]>('/addresses'),
    enabled: !!user,
  });

  const stations = useQuery({
    queryKey: ['pickup-stations', countyCode],
    queryFn: () => api.get<Array<{ id: string; name: string; town: string; countyName: string }>>(`/delivery/pickup-stations?countyCode=${countyCode}`),
    enabled: deliveryMethod === DeliveryMethod.PICKUP,
  });

  const quote = useQuery({
    queryKey: ['delivery-quote', countyCode, deliveryMethod, cart.subtotalCents],
    queryFn: () => api.post<Quote>('/delivery/quote', { countyCode, method: deliveryMethod, subtotalCents: cart.subtotalCents }),
  });

  const placeOrder = useMutation({
    mutationFn: () =>
      api.post<Order>('/orders', {
        deliveryMethod,
        contactName,
        contactPhone,
        countyCode,
        town,
        addressLine1: line1 || undefined,
        landmark: landmark || undefined,
        pickupStationId,
        couponCode: couponCode || undefined,
        items: cart.items
          .filter((i) => !i.savedForLater)
          .map((i) => ({ variantId: i.variantId, quantity: i.quantity })),
      }),
    onSuccess: (o) => {
      setOrder(o);
      setCart({ id: null, items: [], subtotalCents: 0, itemCount: 0 });
      setStep(4);
    },
    onError: (e: Error) => toast({ title: 'Order failed', description: e.message, variant: 'destructive' }),
  });

  if (!user) {
    return (
      <div className="container-tight py-10 text-center">
        <p className="text-sm text-muted-foreground">Please sign in to complete checkout.</p>
        <Link href="/login?next=/checkout" className="mt-3 inline-block"><Button>Sign in</Button></Link>
      </div>
    );
  }

  return (
    <div className="container-tight py-4">
      <h1 className="mb-4 text-xl font-bold">Checkout</h1>
      <ol className="mb-6 flex text-xs" aria-label="Steps">
        {['Address', 'Delivery', 'Review', 'Payment'].map((label, i) => (
          <li key={label} className={`flex-1 border-b-2 pb-2 ${step > i ? 'border-primary text-primary' : 'border-muted text-muted-foreground'}`}>
            <span className="font-semibold">{i + 1}.</span> {label}
          </li>
        ))}
      </ol>

      {step === 1 && (
        <div className="grid gap-4 lg:grid-cols-[1fr_360px]">
          <div className="space-y-3 rounded-lg border bg-white p-4">
            <h2 className="font-semibold">Delivery address</h2>
            {addresses.data && addresses.data.length > 0 && (
              <div className="space-y-2">
                {addresses.data.map((a) => (
                  <label key={a.id} className={`flex cursor-pointer items-start gap-2 rounded-md border p-3 ${addressId === a.id ? 'border-primary bg-primary/5' : ''}`}>
                    <input type="radio" name="addr" checked={addressId === a.id} onChange={() => {
                      setAddressId(a.id);
                      setContactName(a.fullName);
                      setContactPhone(a.phone);
                      setCountyCode(a.countyCode);
                      setTown(a.town);
                      setLine1(a.line1);
                    }} />
                    <div className="text-sm">
                      <p className="font-medium">{a.fullName} · {a.phone}</p>
                      <p className="text-muted-foreground">{a.line1}, {a.town}, {a.countyName}</p>
                    </div>
                  </label>
                ))}
              </div>
            )}
            <div className="grid gap-3 sm:grid-cols-2">
              <div><Label>Full name</Label><Input value={contactName} onChange={(e) => setContactName(e.target.value)} /></div>
              <div><Label>Phone</Label><Input value={contactPhone} onChange={(e) => setContactPhone(e.target.value)} placeholder="07XX XXX XXX" /></div>
              <div>
                <Label>County</Label>
                <select value={countyCode} onChange={(e) => setCountyCode(Number(e.target.value))} className="h-10 w-full rounded-md border border-input bg-background px-3 text-sm">
                  {COUNTIES.map((c) => <option key={c.code} value={c.code}>{c.name}</option>)}
                </select>
              </div>
              <div><Label>Town / Area</Label><Input value={town} onChange={(e) => setTown(e.target.value)} /></div>
              <div className="sm:col-span-2"><Label>Address line</Label><Input value={line1} onChange={(e) => setLine1(e.target.value)} placeholder="Street, building, house #" /></div>
              <div className="sm:col-span-2"><Label>Landmark (optional)</Label><Input value={landmark} onChange={(e) => setLandmark(e.target.value)} /></div>
            </div>
            <div className="flex justify-end">
              <Button onClick={() => setStep(2)} disabled={!contactName || !contactPhone}>Continue</Button>
            </div>
          </div>
          <OrderSummary cart={cart} quote={quote.data} />
        </div>
      )}

      {step === 2 && (
        <div className="grid gap-4 lg:grid-cols-[1fr_360px]">
          <div className="space-y-3 rounded-lg border bg-white p-4">
            <h2 className="font-semibold">Delivery method</h2>
            <label className={`flex cursor-pointer items-start gap-2 rounded-md border p-3 ${deliveryMethod === 'DOOR' ? 'border-primary bg-primary/5' : ''}`}>
              <input type="radio" checked={deliveryMethod === 'DOOR'} onChange={() => setDeliveryMethod(DeliveryMethod.DOOR)} />
              <div className="text-sm">
                <p className="font-medium">Door delivery</p>
                <p className="text-muted-foreground">Estimated {quote.data?.etaDays ?? '—'}</p>
              </div>
            </label>
            <label className={`flex cursor-pointer items-start gap-2 rounded-md border p-3 ${deliveryMethod === 'PICKUP' ? 'border-primary bg-primary/5' : ''}`}>
              <input type="radio" checked={deliveryMethod === 'PICKUP'} onChange={() => setDeliveryMethod(DeliveryMethod.PICKUP)} />
              <div className="text-sm">
                <p className="font-medium">Pickup station</p>
                <p className="text-muted-foreground">Cheaper, collect at your convenience</p>
              </div>
            </label>
            {deliveryMethod === DeliveryMethod.PICKUP && (
              <select value={pickupStationId ?? ''} onChange={(e) => setPickupStationId(e.target.value)} className="h-10 w-full rounded-md border border-input bg-background px-3 text-sm">
                <option value="">Choose a station…</option>
                {stations.data?.map((s) => <option key={s.id} value={s.id}>{s.name} — {s.town}</option>)}
              </select>
            )}
            <div className="flex justify-between">
              <Button variant="outline" onClick={() => setStep(1)}>Back</Button>
              <Button onClick={() => setStep(3)} disabled={deliveryMethod === 'PICKUP' && !pickupStationId}>Continue</Button>
            </div>
          </div>
          <OrderSummary cart={cart} quote={quote.data} />
        </div>
      )}

      {step === 3 && (
        <div className="grid gap-4 lg:grid-cols-[1fr_360px]">
          <div className="space-y-3 rounded-lg border bg-white p-4">
            <h2 className="font-semibold">Review</h2>
            <div className="text-sm">
              <p><span className="text-muted-foreground">Ship to:</span> {contactName}, {contactPhone}</p>
              <p className="text-muted-foreground">{deliveryMethod === 'PICKUP' ? 'Pickup station' : `${line1}, ${town}, ${COUNTIES.find((c) => c.code === countyCode)?.name}`}</p>
            </div>
            <div>
              <Label>Coupon (optional)</Label>
              <Input value={couponCode} onChange={(e) => setCouponCode(e.target.value.toUpperCase())} placeholder="WELCOME10" />
            </div>
            <div className="flex justify-between">
              <Button variant="outline" onClick={() => setStep(2)}>Back</Button>
              <Button onClick={() => placeOrder.mutate()} disabled={placeOrder.isPending}>Place order</Button>
            </div>
          </div>
          <OrderSummary cart={cart} quote={quote.data} />
        </div>
      )}

      {step === 4 && order && (
        <div className="mx-auto max-w-md rounded-lg border bg-white p-6 text-center">
          <h2 className="text-lg font-bold">Order placed!</h2>
          <p className="mt-1 text-sm text-muted-foreground">Order <span className="font-mono font-medium">{order.orderNumber}</span></p>
          <p className="mt-3 text-sm">Total: <span className="font-semibold">{formatPrice(order.totalCents)}</span></p>
          <p className="mt-4 text-sm text-muted-foreground">Choose how to pay to confirm your order.</p>
          <div className="mt-4 grid gap-2">
            <Link href={`/checkout/pay/${order.id}?method=mpesa`}><Button className="w-full">Pay with M-Pesa</Button></Link>
            <Link href={`/checkout/pay/${order.id}?method=card`}><Button variant="outline" className="w-full">Pay with card</Button></Link>
            <Link href={`/checkout/pay/${order.id}?method=pod`}><Button variant="outline" className="w-full">Pay on delivery</Button></Link>
          </div>
        </div>
      )}
    </div>
  );
}

function OrderSummary({ cart, quote }: { cart: any; quote?: Quote }) {
  const subtotal = cart.subtotalCents;
  const fee = quote?.feeCents ?? 0;
  return (
    <aside className="rounded-lg border bg-white p-4 lg:sticky lg:top-20 lg:self-start">
      <h2 className="mb-3 font-semibold">Summary</h2>
      <dl className="space-y-1 text-sm">
        <div className="flex justify-between"><dt>Subtotal</dt><dd>{formatPrice(subtotal)}</dd></div>
        <div className="flex justify-between"><dt>Delivery</dt><dd>{formatPrice(fee)}</dd></div>
        <div className="flex justify-between border-t pt-2 font-semibold"><dt>Total</dt><dd>{formatPrice(subtotal + fee)}</dd></div>
      </dl>
    </aside>
  );
}
