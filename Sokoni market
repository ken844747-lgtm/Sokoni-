import { PutObjectCommand } from '@aws-sdk/client-s3';
import { getSignedUrl } from '@aws-sdk/s3-request-presigner';
import { HttpException, HttpStatus, Injectable } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { randomUUID } from 'crypto';
import { extname } from 'path';
import { ErrorCode } from '@sokoni/shared';
import { S3ClientProvider } from './s3.client';

@Injectable()
export class StorageService {
  constructor(
    private readonly s3: S3ClientProvider,
    private readonly config: ConfigService,
  ) {}

  async presignUpload(opts: {
    filename: string;
    contentType: string;
    folder: string; // e.g. 'products', 'avatars'
  }): Promise<{ uploadUrl: string; publicUrl: string; key: string; expiresIn: number }> {
    const allowed = this.config.get<string[]>('UPLOAD_ALLOWED_MIMES', []);
    if (!allowed.includes(opts.contentType)) {
      throw new HttpException(
        { code: ErrorCode.VALIDATION_ERROR, message: `Content type ${opts.contentType} not allowed` },
        HttpStatus.BAD_REQUEST,
      );
    }
    const ext = extname(opts.filename) || '.bin';
    const key = `${opts.folder}/${new Date().toISOString().slice(0, 10)}/${randomUUID()}${ext}`;
    const ttl = this.config.get<number>('S3_PRESIGN_TTL_SECONDS', 900);
    const cmd = new PutObjectCommand({
      Bucket: this.s3.bucket,
      Key: key,
      ContentType: opts.contentType,
    });
    const uploadUrl = await getSignedUrl(this.s3.client, cmd, { expiresIn: ttl });
    return { uploadUrl, publicUrl: this.s3.publicUrl(key), key, expiresIn: ttl };
  }
}
