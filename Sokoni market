   * Reserves stock atomically and schedules expiry job.
   */
  async placeOrder(userId: string, dto: PlaceOrderDto) {
    if (!dto.items || dto.items.length === 0) {
      throw new HttpException({ code: ErrorCode.CART_EMPTY, message: 'No items to order' }, HttpStatus.BAD_REQUEST);
    }
    const county = COUNTIES.find((c) => c.code === dto.countyCode);
    if (!county) throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Invalid county' }, HttpStatus.BAD_REQUEST);

    if (dto.deliveryMethod === DeliveryMethod.PICKUP && !dto.pickupStationId) {
      throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Pickup station required' }, HttpStatus.BAD_REQUEST);
    }

    const contactPhone = normalizeKenyanPhone(dto.contactPhone);
    if (!contactPhone) throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Invalid phone' }, HttpStatus.BAD_REQUEST);

    const reservationUntil = new Date(Date.now() + STOCK_RESERVATION_MINUTES * 60_000);
    const orderNumber = generateOrderNumber();

    // ── Transaction: verify stock, reserve, snapshot items, create order ──
    const created = await this.prisma.$transaction(async (tx) => {
      // Lock and fetch variants with inventory
      const variantIds = dto.items.map((i) => i.variantId);
      const variants = await tx.variant.findMany({
        where: { id: { in: variantIds } },
        include: { product: true, inventory: true },
      });
      const byId = new Map(variants.map((v) => [v.id, v]));

      // Validate + snapshot
      let subtotalCents = 0;
      const itemsData: Prisma.OrderItemCreateWithoutOrderInput[] = [];
      for (const line of dto.items) {
        const v = byId.get(line.variantId);
        if (!v) throw new HttpException({ code: ErrorCode.PRODUCT_NOT_FOUND, message: `Variant ${line.variantId} not found` }, HttpStatus.BAD_REQUEST);
        if (v.product.status !== 'ACTIVE') throw new HttpException({ code: ErrorCode.PRODUCT_NOT_FOUND, message: `Product ${v.product.name} unavailable` }, HttpStatus.BAD_REQUEST);
        const inv = v.inventory;
        if (!inv) throw new HttpException({ code: ErrorCode.PRODUCT_OUT_OF_STOCK, message: 'Out of stock' }, HttpStatus.CONFLICT);
        const available = Math.max(0, inv.quantity - inv.reservedQty);
        if (available < line.quantity) {
          throw new HttpException(
            { code: ErrorCode.PRODUCT_OUT_OF_STOCK, message: `Only ${available} of "${v.product.name}" left` },
            HttpStatus.CONFLICT,
          );
        }

        // Reserve stock
        await tx.inventory.update({
          where: { variantId: v.id },
          data: {
            reservedQty: { increment: line.quantity },
            reservedUntil: reservationUntil,
          },
        });

        const lineTotal = v.priceCents * line.quantity;
        subtotalCents += lineTotal;
        const vendor = await tx.vendor.findUnique({ where: { id: v.product.vendorId }, select: { commissionBps: true } });
        const commissionBps = vendor?.commissionBps ?? 1000;
        const commissionCents = Math.round((lineTotal * commissionBps) / 10_000);
        const vendorEarningCents = lineTotal - commissionCents;
        itemsData.push({
          product: { connect: { id: v.product.id } },
          variant: { connect: { id: v.id } },
          vendorId: v.product.vendorId,
          productName: v.product.name,
          variantName: v.name,
          sku: v.sku,
          unitPriceCents: v.priceCents,
          quantity: line.quantity,
          lineTotalCents: lineTotal,
          imageUrl: v.imageUrl ?? (v.product.images as string[])?.[0] ?? null,
          commissionBps,
          commissionCents,
          vendorEarningCents,
        });
      }

      // Coupon
      let discountCents = 0;
      let appliedCode: string | undefined;
      if (dto.couponCode) {
        const check = await this.coupons.validate(dto.couponCode, subtotalCents, userId);
        if (check.valid) {
          discountCents = check.discountCents;
          appliedCode = check.coupon!.code;
        } else {
          throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: check.reason ?? 'Coupon invalid' }, HttpStatus.BAD_REQUEST);
        }
      }

      // Delivery
      const deliveryFeeCents = calculateDeliveryFee(county.zone, dto.deliveryMethod);
      const totalCents = subtotalCents + deliveryFeeCents - discountCents;

      const order = await tx.order.create({
        data: {
          orderNumber,
          userId,
          status: OrderStatus.PENDING_PAYMENT,
          subtotalCents,
          deliveryFeeCents,
          discountCents,
          totalCents,
          deliveryMethod: dto.deliveryMethod,
          countyCode: dto.countyCode,
          countyName: county.name,
          town: dto.town,
          addressLine1: dto.addressLine1,
          addressLine2: dto.addressLine2,
          landmark: dto.landmark,
          pickupStationId: dto.pickupStationId,
          contactName: dto.contactName,
          contactPhone,
          customerNote: dto.customerNote,
          couponCode: appliedCode,
          expiresAt: reservationUntil,
          items: { create: itemsData },
          events: { create: { toStatus: OrderStatus.PENDING_PAYMENT, actorId: userId, actorRole: 'CUSTOMER', note: 'Order placed, awaiting payment' } },
        },
        include: orderInclude,
      });

      if (appliedCode) await this.coupons.applyUsage(appliedCode, tx);

      return order;
    });

    // Schedule reservation expiry
    await this.stockQueue.add(
      'release',
      { orderId: created.id },
      { delay: STOCK_RESERVATION_MINUTES * 60_000, jobId: `release-${created.id}` },
    );

    await this.notifications.notify({
      userId,
      title: 'Order placed',
      body: `Order ${created.orderNumber} created. Complete payment to confirm.`,
      data: { orderId: created.id },
      channels: [NotificationChannel.IN_APP],
    });
    await this.audit.record({
      actorId: userId,
      action: 'ORDER_PLACED',
      entity: 'Order',
      entityId: created.id,
      after: { orderNumber: created.orderNumber, totalCents: created.totalCents },
    });

    return created;
  }

  async listForUser(userId: string, opts: { page?: number; perPage?: number; status?: OrderStatus } = {}) {
    const page = opts.page ?? 1;
    const perPage = Math.min(opts.perPage ?? 20, 50);
    const where: Prisma.OrderWhereInput = { userId, ...(opts.status ? { status: opts.status } : {}) };
    const [rows, total] = await Promise.all([
      this.prisma.order.findMany({
        where,
        include: orderInclude,
        orderBy: { createdAt: 'desc' },
        skip: (page - 1) * perPage,
        take: perPage,
      }),
      this.prisma.order.count({ where }),
    ]);
    return paginated(rows, total, page, perPage);
  }

  async findForUser(userId: string, orderId: string, isAdmin = false) {
    const order = await this.prisma.order.findUnique({ where: { id: orderId }, include: orderInclude });
    if (!order) throw new HttpException({ code: ErrorCode.ORDER_NOT_FOUND, message: 'Order not found' }, HttpStatus.NOT_FOUND);
    if (!isAdmin && order.userId !== userId) {
      throw new HttpException({ code: ErrorCode.AUTH_FORBIDDEN, message: 'Not your order' }, HttpStatus.FORBIDDEN);
    }
    return order;
  }

  async cancel(userId: string, orderId: string, dto: CancelOrderDto, isAdmin = false) {
    const order = await this.prisma.order.findUnique({ where: { id: orderId }, include: { items: true } });
    if (!order) throw new HttpException({ code: ErrorCode.ORDER_NOT_FOUND, message: 'Order not found' }, HttpStatus.NOT_FOUND);
    if (!isAdmin && order.userId !== userId) throw new HttpException({ code: ErrorCode.AUTH_FORBIDDEN, message: 'Not your order' }, HttpStatus.FORBIDDEN);
    if (!['PENDING_PAYMENT', 'PAID', 'PROCESSING'].includes(order.status)) {
      throw new HttpException({ code: ErrorCode.ORDER_INVALID_TRANSITION, message: `Cannot cancel in ${order.status}` }, HttpStatus.BAD_REQUEST);
    }
    if (order.status === OrderStatus.PAID && !isAdmin) {
      throw new HttpException(
        { code: ErrorCode.ORDER_INVALID_TRANSITION, message: 'Paid orders require a refund request' },
        HttpStatus.BAD_REQUEST,
      );
    }

    await this.prisma.$transaction(async (tx) => {
      if (order.status === OrderStatus.PENDING_PAYMENT) {
        for (const item of order.items) {
          await tx.inventory.update({
            where: { variantId: item.variantId },
            data: { reservedQty: { decrement: item.quantity } },
          });
        }
      }
      await tx.order.update({
        where: { id: orderId },
        data: {
          status: OrderStatus.CANCELLED,
          cancelledAt: new Date(),
          cancelReason: dto.reason,
          events: { create: { fromStatus: order.status, toStatus: OrderStatus.CANCELLED, actorId: userId, actorRole: isAdmin ? 'ADMIN' : 'CUSTOMER', note: dto.reason } },
        },
      });
    });

    // Remove any scheduled release (order already cancelled)
    await this.stockQueue.remove(`release-${orderId}`).catch(() => undefined);

    await this.notifications.notify({
      userId: order.userId,
      title: 'Order cancelled',
      body: `Order ${order.orderNumber} has been cancelled.`,
      channels: [NotificationChannel.IN_APP, NotificationChannel.SMS],
    });
    await this.audit.record({
      actorId: userId,
      action: 'ORDER_CANCELLED',
      entity: 'Order',
      entityId: orderId,
      before: { status: order.status },
      after: { status: OrderStatus.CANCELLED, reason: dto.reason },
    });

    return this.prisma.order.findUnique({ where: { id: orderId }, include: orderInclude });
  }

  /**
   * Shared by admin, vendor, and internal processors: transition status with guard.
   * Adds an OrderEvent and fires notifications.
   */
  async transitionOrder(opts: {
    orderId: string;
    to: OrderStatus;
    actorId?: string;
    actorRole?: string;
    note?: string;
  }) {
    return this.prisma.$transaction(async (tx) => {
      const order = await tx.order.findUnique({ where: { id: opts.orderId } });
      if (!order) throw new HttpException({ code: ErrorCode.ORDER_NOT_FOUND, message: 'Order not found' }, HttpStatus.NOT_FOUND);
      assertTransition(order.status, opts.to);
      return tx.order.update({
        where: { id: opts.orderId },
        data: {
          status: opts.to,
          paidAt: opts.to === OrderStatus.PAID ? new Date() : order.paidAt,
          deliveredAt: opts.to === OrderStatus.DELIVERED ? new Date() : order.deliveredAt,
          events: { create: { fromStatus: order.status, toStatus: opts.to, actorId: opts.actorId, actorRole: opts.actorRole, note: opts.note } },
        },
        include: orderInclude,
      });
    });
  }

  async listForAdmin(opts: { page?: number; perPage?: number; status?: OrderStatus; q?: string } = {}) {
    const page = opts.page ?? 1;
    const perPage = Math.min(opts.perPage ?? 30, 100);
    const where: Prisma.OrderWhereInput = {};
    if (opts.status) where.status = opts.status;
    if (opts.q) where.orderNumber = { contains: opts.q, mode: 'insensitive' };
    const [rows, total] = await Promise.all([
      this.prisma.order.findMany({ where, include: orderInclude, orderBy: { createdAt: 'desc' }, skip: (page - 1) * perPage, take: perPage }),
      this.prisma.order.count({ where }),
    ]);
    return paginated(rows, total, page, perPage);
  }
}
