export function CategoryFilters({ categorySlug, onApply }: { categorySlug: string; onApply: () => void }) {
  const router = useRouter();
  const search = useSearchParams();
  const [minPrice, setMinPrice] = useState(search.get('minPrice') ?? '');
  const [maxPrice, setMaxPrice] = useState(search.get('maxPrice') ?? '');
  const [brand, setBrand] = useState(search.get('brand') ?? '');
  const [minRating, setMinRating] = useState(search.get('minRating') ?? '');

  function apply() {
    const sp = new URLSearchParams();
    if (minPrice) sp.set('minPrice', String(Math.round(Number(minPrice) * 100)));
    if (maxPrice) sp.set('maxPrice', String(Math.round(Number(maxPrice) * 100)));
    if (brand) sp.set('brand', brand);
    if (minRating) sp.set('minRating', minRating);
    router.push(`/category/${categorySlug}?${sp.toString()}`);
    onApply();
  }

  function clear() {
    setMinPrice(''); setMaxPrice(''); setBrand(''); setMinRating('');
    router.push(`/category/${categorySlug}`);
  }

  return (
    <aside className="rounded-lg border bg-white p-4">
      <h2 className="mb-3 text-sm font-bold">Filters</h2>
      <div className="space-y-3">
        <div>
          <Label className="text-xs">Price range (KES)</Label>
          <div className="mt-1 flex gap-2">
            <Input type="number" min={0} placeholder="Min" value={minPrice} onChange={(e) => setMinPrice(e.target.value)} />
            <Input type="number" min={0} placeholder="Max" value={maxPrice} onChange={(e) => setMaxPrice(e.target.value)} />
          </div>
        </div>
        <div>
          <Label className="text-xs">Brand</Label>
          <Input value={brand} onChange={(e) => setBrand(e.target.value)} placeholder="e.g. Samsung" />
        </div>
        <div>
          <Label className="text-xs">Minimum rating</Label>
          <Input type="number" min={0} max={5} step={0.5} value={minRating} onChange={(e) => setMinRating(e.target.value)} />
        </div>
        <div className="flex gap-2 pt-2">
          <Button size="sm" className="flex-1" onClick={apply}>Apply</Button>
          <Button size="sm" variant="outline" onClick={clear}>Clear</Button>
        </div>
      </div>
    </aside>
  );
}
