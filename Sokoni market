import { CanActivate, ExecutionContext, ForbiddenException, Injectable } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { timingSafeEqual } from 'crypto';
import { ErrorCode } from '@sokoni/shared';
import { CSRF_COOKIE } from '../../auth/cookies';
import { IS_PUBLIC_KEY } from '../decorators/public.decorator';
import { Reflector } from '@nestjs/core';

const SAFE_METHODS = new Set(['GET', 'HEAD', 'OPTIONS']);

@Injectable()
export class CsrfGuard implements CanActivate {
  constructor(private readonly reflector: Reflector, private readonly config: ConfigService) {}

  canActivate(ctx: ExecutionContext): boolean {
    const req = ctx.switchToHttp().getRequest();
    if (SAFE_METHODS.has(req.method)) return true;

    const isPublic = this.reflector.getAllAndOverride<boolean>(IS_PUBLIC_KEY, [
      ctx.getHandler(),
      ctx.getClass(),
    ]);

    // Bearer-token clients (mobile, scripts) are exempt from CSRF.
    const authHeader: string | undefined = req.headers.authorization;
    if (authHeader?.startsWith('Bearer ')) return true;

    // Cookie auth requires the double-submit header to match the CSRF cookie.
    const cookie = req.cookies?.[CSRF_COOKIE];
    const header = req.headers['x-csrf-token'];

    if (!cookie || typeof header !== 'string' || header.length === 0) {
      throw new ForbiddenException({ code: ErrorCode.AUTH_FORBIDDEN, message: 'Missing CSRF token' });
    }

    const a = Buffer.from(String(cookie));
    const b = Buffer.from(header);
    if (a.length !== b.length || !timingSafeEqual(a, b)) {
      throw new ForbiddenException({ code: ErrorCode.AUTH_FORBIDDEN, message: 'Invalid CSRF token' });
    }
    return true;
  }
}
