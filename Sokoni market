@Injectable()
export class WishlistService {
  constructor(private readonly prisma: PrismaService) {}

  async list(userId: string) {
    const rows = await this.prisma.wishlistItem.findMany({
      where: { userId },
      orderBy: { createdAt: 'desc' },
      include: {
        product: {
          select: {
            id: true, name: true, slug: true, images: true, basePriceCents: true, compareAtCents: true,
            ratingAvg: true, ratingCount: true, status: true,
          },
        },
      },
    });
    return rows.map((r) => ({
      id: r.id,
      createdAt: r.createdAt,
      product: { ...r.product, imageUrl: (r.product.images as string[])?.[0] ?? null },
    }));
  }

  async add(userId: string, productId: string) {
    const exists = await this.prisma.product.findUnique({ where: { id: productId } });
    if (!exists) return null;
    const existing = await this.prisma.wishlistItem.findUnique({
      where: { userId_productId: { userId, productId } },
    });
    if (existing) return existing;
    return this.prisma.wishlistItem.create({ data: { userId, productId } });
  }

  async remove(userId: string, productId: string) {
    await this.prisma.wishlistItem.deleteMany({ where: { userId, productId } });
    return { message: 'Removed' };
  }
}
