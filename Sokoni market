import type { DeliveryZoneId } from './counties';
import { DeliveryMethod } from './enums';

export interface DeliveryFeeRule {
  zone: DeliveryZoneId;
  doorFeeCents: number;
  pickupFeeCents: number;
  etaDays: string;
}

export const DELIVERY_FEES: Record<DeliveryZoneId, DeliveryFeeRule> = {
  NAIROBI_METRO: { zone: 'NAIROBI_METRO', doorFeeCents: 200_00, pickupFeeCents: 100_00, etaDays: '1–2 days' },
  MAJOR_TOWN:   { zone: 'MAJOR_TOWN',   doorFeeCents: 350_00, pickupFeeCents: 150_00, etaDays: '2–4 days' },
  REGIONAL:     { zone: 'REGIONAL',     doorFeeCents: 500_00, pickupFeeCents: 200_00, etaDays: '3–6 days' },
  REMOTE:       { zone: 'REMOTE',       doorFeeCents: 750_00, pickupFeeCents: 300_00, etaDays: '5–9 days' },
};

export function calculateDeliveryFee(zone: DeliveryZoneId, method: DeliveryMethod): number {
  const rule = DELIVERY_FEES[zone];
  return method === DeliveryMethod.PICKUP ? rule.pickupFeeCents : rule.doorFeeCents;
}

export function estimateDelivery(zone: DeliveryZoneId): string {
  return DELIVERY_FEES[zone].etaDays;
}
