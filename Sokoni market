@Injectable()
export class CartService {
  constructor(private readonly prisma: PrismaService) {}

  private availableQty(inv?: { quantity: number; reservedQty: number } | null): number {
    if (!inv) return 0;
    return Math.max(0, inv.quantity - inv.reservedQty);
  }

  async getCart(opts: { userId?: string; sid?: string }) {
    const cart = await this.findOrCreate(opts, false);
    if (!cart) return this.emptyResponse();
    return this.serialize(cart);
  }

  private emptyResponse() {
    return {
      id: null,
      items: [],
      subtotalCents: 0,
      itemCount: 0,
    };
  }

  private async findOrCreate(opts: { userId?: string; sid?: string }, create: boolean) {
    if (opts.userId) {
      const existing = await this.prisma.cart.findFirst({
        where: { userId: opts.userId },
        include: cartInclude,
      });
      if (existing) return existing;
      if (!create) return null;
      return this.prisma.cart.create({ data: { userId: opts.userId }, include: cartInclude });
    }
    if (opts.sid) {
      const existing = await this.prisma.cart.findUnique({ where: { sessionId: opts.sid }, include: cartInclude });
      if (existing) return existing;
      if (!create) return null;
      return this.prisma.cart.create({ data: { sessionId: opts.sid }, include: cartInclude });
    }
    return null;
  }

  private serialize(cart: any) {
    const items = cart.items.map((it: any) => {
      const available = this.availableQty(it.variant.inventory);
      const unitPriceCents = it.variant.priceCents;
      return {
        id: it.id,
        variantId: it.variantId,
        quantity: it.quantity,
        savedForLater: it.savedForLater,
        unitPriceCents,
        lineTotalCents: unitPriceCents * it.quantity,
        available,
        variant: {
          id: it.variant.id,
          sku: it.variant.sku,
          name: it.variant.name,
          optionValues: it.variant.optionValues,
          imageUrl: it.variant.imageUrl,
        },
        product: {
          id: it.variant.product.id,
          name: it.variant.product.name,
          slug: it.variant.product.slug,
          imageUrl: (it.variant.product.images as string[])?.[0] ?? null,
          vendorId: it.variant.product.vendorId,
          vendorName: it.variant.product.vendor.storeName,
          status: it.variant.product.status,
        },
      };
    });
    const active = items.filter((i: any) => !i.savedForLater);
    const subtotalCents = active.reduce((s: number, i: any) => s + i.lineTotalCents, 0);
    const itemCount = active.reduce((s: number, i: any) => s + i.quantity, 0);
    return { id: cart.id, items, subtotalCents, itemCount };
  }

  async addItem(opts: { userId?: string; sid?: string }, dto: AddCartItemDto) {
    const variant = await this.prisma.variant.findUnique({
      where: { id: dto.variantId },
      include: { inventory: true, product: true },
    });
    if (!variant || variant.product.status !== 'ACTIVE') {
      throw new HttpException({ code: ErrorCode.PRODUCT_NOT_FOUND, message: 'Variant unavailable' }, HttpStatus.NOT_FOUND);
    }
    const available = this.availableQty(variant.inventory);
    if (available < dto.quantity) {
      throw new HttpException(
        { code: ErrorCode.PRODUCT_OUT_OF_STOCK, message: `Only ${available} available` },
        HttpStatus.CONFLICT,
      );
    }

    const cart = await this.findOrCreate(opts, true);
    if (!cart) throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'No cart context' }, HttpStatus.BAD_REQUEST);

    const existing = await this.prisma.cartItem.findUnique({
      where: { cartId_variantId: { cartId: cart.id, variantId: dto.variantId } },
    });

    if (existing) {
      const newQty = existing.quantity + dto.quantity;
      if (newQty > available) {
        throw new HttpException({ code: ErrorCode.PRODUCT_OUT_OF_STOCK, message: `Only ${available} available` }, HttpStatus.CONFLICT);
      }
      await this.prisma.cartItem.update({
        where: { id: existing.id },
        data: { quantity: newQty, savedForLater: false },
      });
    } else {
      await this.prisma.cartItem.create({
        data: { cartId: cart.id, variantId: dto.variantId, quantity: dto.quantity },
      });
    }

    const fresh = await this.prisma.cart.findUniqueOrThrow({ where: { id: cart.id }, include: cartInclude });
    return this.serialize(fresh);
  }

  async updateItem(opts: { userId?: string; sid?: string }, itemId: string, dto: UpdateCartItemDto) {
    const cart = await this.findOrCreate(opts, false);
    if (!cart) throw new HttpException({ code: ErrorCode.CART_ITEM_NOT_FOUND, message: 'Cart empty' }, HttpStatus.NOT_FOUND);
    const item = cart.items.find((i: any) => i.id === itemId);
    if (!item) throw new HttpException({ code: ErrorCode.CART_ITEM_NOT_FOUND, message: 'Item not found' }, HttpStatus.NOT_FOUND);

    if (dto.quantity !== undefined && dto.quantity > 0) {
      const available = this.availableQty(item.variant.inventory);
      if (dto.quantity > available) {
        throw new HttpException({ code: ErrorCode.PRODUCT_OUT_OF_STOCK, message: `Only ${available} available` }, HttpStatus.CONFLICT);
      }
    }

    if (dto.quantity === 0) {
      await this.prisma.cartItem.delete({ where: { id: itemId } });
    } else {
      await this.prisma.cartItem.update({
        where: { id: itemId },
        data: { quantity: dto.quantity, savedForLater: dto.savedForLater },
      });
    }

    const fresh = await this.prisma.cart.findUniqueOrThrow({ where: { id: cart.id }, include: cartInclude });
    return this.serialize(fresh);
  }

  async removeItem(opts: { userId?: string; sid?: string }, itemId: string) {
    const cart = await this.findOrCreate(opts, false);
    if (!cart) return this.emptyResponse();
    const item = cart.items.find((i: any) => i.id === itemId);
    if (item) await this.prisma.cartItem.delete({ where: { id: itemId } });
    const fresh = await this.prisma.cart.findUnique({ where: { id: cart.id }, include: cartInclude });
    return fresh ? this.serialize(fresh) : this.emptyResponse();
  }

  async clear(opts: { userId?: string; sid?: string }) {
    const cart = await this.findOrCreate(opts, false);
    if (cart) await this.prisma.cartItem.deleteMany({ where: { cartId: cart.id } });
    return this.emptyResponse();
  }

  async mergeGuestIntoUser(sid: string, userId: string) {
    const guest = await this.prisma.cart.findUnique({ where: { sessionId: sid }, include: { items: true } });
    if (!guest || guest.items.length === 0) return;
    const userCart = (await this.prisma.cart.findFirst({ where: { userId } }))
      ?? (await this.prisma.cart.create({ data: { userId } }));

    for (const it of guest.items) {
      const existing = await this.prisma.cartItem.findUnique({
        where: { cartId_variantId: { cartId: userCart.id, variantId: it.variantId } },
      });
      if (existing) {
        await this.prisma.cartItem.update({
          where: { id: existing.id },
          data: { quantity: existing.quantity + it.quantity },
        });
      } else {
        await this.prisma.cartItem.create({
          data: { cartId: userCart.id, variantId: it.variantId, quantity: it.quantity },
        });
      }
    }
    await this.prisma.cart.delete({ where: { id: guest.id } });
  }
}

