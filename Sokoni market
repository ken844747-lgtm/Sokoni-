@ApiTags('auth')
@Controller('auth')
export class AuthController {
  constructor(
    private readonly auth: AuthService,
    private readonly otp: OtpService,
    private readonly config: ConfigService,
  ) {}

  private secure(): boolean {
    return this.config.get<boolean>('COOKIE_SECURE', false);
  }

  private respondWithSession(res: Response, user: SessionUser, pair: TokenPair, extra?: Record<string, unknown>) {
    const csrfToken = randomBytes(24).toString('hex');
    setAuthCookies(res, { ...pair, csrfToken }, this.secure());
    res.json({
      success: true,
      data: {
        user,
        accessToken: pair.accessToken,
        expiresIn: pair.accessTtlSec,
        ...extra,
      },
    });
  }

  @Public()
  @Post('register')
  @Throttle({ default: { limit: 10, ttl: 60_000 } })
  async register(@Body() dto: RegisterDto, @Res({ passthrough: true }) res: Response) {
    const { user, pair } = await this.auth.register(dto);
    this.respondWithSession(res, user, pair);
  }

  @Public()
  @HttpCode(200)
  @Post('login')
  @Throttle({ default: { limit: 10, ttl: 60_000 } })
  async login(@Body() dto: LoginDto, @Res({ passthrough: true }) res: Response) {
    const { user, pair } = await this.auth.login(dto);
    this.respondWithSession(res, user, pair);
  }

  @Public()
  @HttpCode(200)
  @Post('otp/request')
  @Throttle({ default: { limit: 5, ttl: 60_000 } })
  async requestOtp(@Body() dto: RequestOtpDto) {
    const { expiresAt } = await this.otp.request(dto.phone, (dto.purpose ?? 'LOGIN') as any);
    return { message: 'If the number is registered, an OTP has been sent.', expiresAt };
  }

  @Public()
  @HttpCode(200)
  @Post('otp/verify')
  @Throttle({ default: { limit: 10, ttl: 60_000 } })
  async verifyOtp(@Body() dto: VerifyOtpDto, @Res({ passthrough: true }) res: Response) {
    const { user, pair } = await this.auth.loginWithOtp(dto.phone, dto.code);
    this.respondWithSession(res, user, pair);
  }

  @Public()
  @HttpCode(200)
  @Post('refresh')
  async refresh(@Req() req: Request, @Res({ passthrough: true }) res: Response) {
    const token = (req as any).cookies?.[REFRESH_COOKIE];
    if (!token) {
      clearAuthCookies(res, this.secure());
      res.status(401).json({ success: false, error: { code: 'AUTH_UNAUTHORIZED', message: 'No refresh token' } });
      return;
    }
    const { user, pair } = await this.auth.refresh(token);
    this.respondWithSession(res, user, pair);
  }

  @Post('logout')
  @UseGuards(JwtAuthGuard)
  @HttpCode(200)
  async logout(@Req() req: Request, @Res({ passthrough: true }) res: Response) {
    const token = (req as any).cookies?.[REFRESH_COOKIE];
    await this.auth.logout(token);
    clearAuthCookies(res, this.secure());
    return { message: 'Logged out' };
  }

  @Get('me')
  @UseGuards(JwtAuthGuard)
  async me(@CurrentUser() user: AuthUser) {
    return this.auth.me(user.id);
  }

  @Public()
  @HttpCode(200)
  @Post('forgot-password')
  async forgot(_dto: ForgotPasswordDto) {
    // Implemented in Phase 3 with email provider
    return { message: 'If the email exists, a reset link has been sent.' };
  }

  @Public()
  @HttpCode(200)
  @Post('reset-password')
  async reset(_dto: ResetPasswordDto) {
    return { message: 'Password reset not yet enabled' };
  }
}
