import { Injectable } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { JwtService } from '@nestjs/jwt';
import { createHash, randomBytes } from 'crypto';
import { PrismaService } from '../prisma/prisma.service';
import { Role } from '@sokoni/shared';

export interface AccessPayload {
  sub: string;
  role: Role;
  vendorId?: string | null;
}

export interface RefreshPayload {
  sub: string;
  fam: string;
}

export interface TokenPair {
  accessToken: string;
  refreshToken: string;
  refreshTokenId: string;
  accessTtlSec: number;
  refreshTtlSec: number;
}

@Injectable()
export class TokensService {
  constructor(
    private readonly jwt: JwtService,
    private readonly config: ConfigService,
    private readonly prisma: PrismaService,
  ) {}

  private parseTtl(ttl: string): number {
    const m = /^(\d+)([smhd])$/.exec(ttl);
    if (!m) return 900;
    const n = parseInt(m[1], 10);
    const unit = m[2];
    const mult = unit === 's' ? 1 : unit === 'm' ? 60 : unit === 'h' ? 3600 : 86400;
    return n * mult;
  }

  async issuePair(userId: string, role: Role, vendorId?: string | null, familyId?: string): Promise<TokenPair> {
    const accessTtl = this.config.get<string>('JWT_ACCESS_TTL', '15m');
    const refreshTtl = this.config.get<string>('JWT_REFRESH_TTL', '7d');
    const accessTtlSec = this.parseTtl(accessTtl);
    const refreshTtlSec = this.parseTtl(refreshTtl);

    const accessToken = await this.jwt.signAsync(
      { sub: userId, role, vendorId } satisfies AccessPayload,
      { secret: this.config.getOrThrow('JWT_ACCESS_SECRET'), expiresIn: accessTtl },
    );

    const fam = familyId ?? randomBytes(16).toString('hex');
    const refreshToken = await this.jwt.signAsync(
      { sub: userId, fam } satisfies RefreshPayload,
      { secret: this.config.getOrThrow('JWT_REFRESH_SECRET'), expiresIn: refreshTtl },
    );

    const tokenHash = createHash('sha256').update(refreshToken).digest('hex');
    const row = await this.prisma.refreshToken.create({
      data: {
        userId,
        tokenHash,
        familyId: fam,
        expiresAt: new Date(Date.now() + refreshTtlSec * 1000),
      },
    });

    return { accessToken, refreshToken, refreshTokenId: row.id, accessTtlSec, refreshTtlSec };
  }

  async rotate(refreshToken: string): Promise<{ userId: string; role: Role; vendorId: string | null; pair: TokenPair } | null> {
    const tokenHash = createHash('sha256').update(refreshToken).digest('hex');
    const record = await this.prisma.refreshToken.findUnique({ where: { tokenHash }, include: { user: { include: { vendor: true } } } });

    if (!record || record.revokedAt || record.expiresAt < new Date()) {
      // Reuse detected — revoke the whole family (token theft defense)
      if (record) await this.revokeFamily(record.familyId);
      return null;
    }

    // Rotate: revoke old, issue new in same family
    await this.prisma.refreshToken.update({ where: { id: record.id }, data: { revokedAt: new Date() } });
    const pair = await this.issuePair(record.userId, record.user.role, record.user.vendor?.id ?? null, record.familyId);
    return {
      userId: record.userId,
      role: record.user.role,
      vendorId: record.user.vendor?.id ?? null,
      pair,
    };
  }

  async revoke(refreshToken: string): Promise<void> {
    const tokenHash = createHash('sha256').update(refreshToken).digest('hex');
    const record = await this.prisma.refreshToken.findUnique({ where: { tokenHash } });
    if (record) await this.prisma.refreshToken.update({ where: { id: record.id }, data: { revokedAt: new Date() } });
  }

  async revokeFamily(familyId: string): Promise<void> {
    await this.prisma.refreshToken.updateMany({
      where: { familyId, revokedAt: null },
      data: { revokedAt: new Date() },
    });
  }
}
