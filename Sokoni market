import { Request } from 'express';
import { ExtractJwt, Strategy } from 'passport-jwt';
import { AuthUser } from '../common/decorators/current-user.decorator';
import { AccessPayload } from './tokens.service';

function fromCookieOrHeader(req: Request): string | null {
  const auth = req.headers.authorization;
  if (auth?.startsWith('Bearer ')) return auth.slice(7);
  const cookie = (req as any).cookies?.sokoni_access;
  return typeof cookie === 'string' && cookie.length > 0 ? cookie : null;
}

@Injectable()
export class JwtStrategy extends PassportStrategy(Strategy, 'jwt') {
  constructor(config: ConfigService) {
    super({
      jwtFromRequest: ExtractJwt.fromExtractors([fromCookieOrHeader]),
      ignoreExpiration: false,
      secretOrKey: config.getOrThrow<string>('JWT_ACCESS_SECRET'),
    });
  }

  async validate(payload: AccessPayload): Promise<AuthUser> {
    return {
      id: payload.sub,
      role: payload.role,
      vendorId: payload.vendorId ?? null,
    };
  }
}
import { CookieOptions, Response } from 'express';

export const ACCESS_COOKIE = 'sokoni_access';
export const REFRESH_COOKIE = 'sokoni_refresh';
export const CSRF_COOKIE = 'sokoni_csrf';

export function cookieOptions(secure: boolean): CookieOptions {
  return { httpOnly: true, secure, sameSite: 'lax', path: '/' };
}

export function csrfCookieOptions(secure: boolean): CookieOptions {
  return { httpOnly: false, secure, sameSite: 'lax', path: '/' };
}

export function setAuthCookies(
  res: Response,
  tokens: { accessToken: string; refreshToken: string; accessTtlSec: number; refreshTtlSec: number; csrfToken: string },
  secure: boolean,
): void {
  res.cookie(ACCESS_COOKIE, tokens.accessToken, { ...cookieOptions(secure), maxAge: tokens.accessTtlSec * 1000 });
  res.cookie(REFRESH_COOKIE, tokens.refreshToken, { ...cookieOptions(secure), maxAge: tokens.refreshTtlSec * 1000 });
  res.cookie(CSRF_COOKIE, tokens.csrfToken, { ...csrfCookieOptions(secure), maxAge: tokens.refreshTtlSec * 1000 });
}

export function clearAuthCookies(res: Response, secure: boolean): void {
  res.clearCookie(ACCESS_COOKIE, cookieOptions(secure));
  res.clearCookie(REFRESH_COOKIE, cookieOptions(secure));
  res.clearCookie(CSRF_COOKIE, csrfCookieOptions(secure));
}
