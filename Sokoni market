export interface NotifyInput {
  userId: string;
  title: string;
  body: string;
  data?: Record<string, unknown>;
  channels?: NotificationChannel[];
}

@Injectable()
export class NotificationsService {
  private readonly logger = new Logger(NotificationsService.name);

  constructor(
    private readonly prisma: PrismaService,
    @InjectQueue(QUEUE_NAMES.NOTIFICATIONS) private readonly queue: Queue,
  ) {}

  /** Create in-app notification immediately; queue external channels. */
  async notify(input: NotifyInput) {
    const channels = input.channels ?? [NotificationChannel.IN_APP];
    if (channels.includes(NotificationChannel.IN_APP)) {
      await this.prisma.notification.create({
        data: {
          userId: input.userId,
          channel: NotificationChannel.IN_APP,
          title: input.title,
          body: input.body,
          data: (input.data ?? {}) as any,
        },
      });
    }
    for (const channel of channels) {
      if (channel === NotificationChannel.IN_APP) continue;
      await this.queue.add(
        'send',
        { userId: input.userId, title: input.title, body: input.body, channel, data: input.data },
        { jobId: `${channel}-${input.userId}-${Date.now()}` },
      );
    }
  }

  async list(userId: string, opts: { onlyUnread?: boolean } = {}) {
    return this.prisma.notification.findMany({
      where: { userId, ...(opts.onlyUnread ? { readAt: null } : {}) },
      orderBy: { createdAt: 'desc' },
      take: 100,
    });
  }

  async markRead(userId: string, id: string) {
    const n = await this.prisma.notification.findFirst({ where: { id, userId } });
    if (!n) return { message: 'Not found' };
    await this.prisma.notification.update({ where: { id }, data: { readAt: new Date() } });
    return { message: 'Read' };
  }

  async markAllRead(userId: string) {
    await this.prisma.notification.updateMany({ where: { userId, readAt: null }, data: { readAt: new Date() } });
    return { message: 'All read' };
  }
}
import { Processor, WorkerHost } from '@nestjs/bullmq';
import { Logger } from '@nestjs/common';
import { Job } from 'bullmq';
import { NotificationChannel } from '@sokoni/shared';
import { PrismaService } from '../prisma/prisma.service';
import { SmsService } from '../integrations/sms/sms.service';
import { EmailService } from '../integrations/email/email.service';
import { QUEUE_NAMES } from '../queue/queue.module';

@Processor(QUEUE_NAMES.NOTIFICATIONS)
export class NotificationsProcessor extends WorkerHost {
  private readonly logger = new Logger(NotificationsProcessor.name);

  constructor(
    private readonly prisma: PrismaService,
    private readonly sms: SmsService,
    private readonly email: EmailService,
  ) {
    super();
  }

  async process(job: Job): Promise<void> {
    const { userId, title, body, channel } = job.data as {
      userId: string;
      title: string;
      body: string;
      channel: NotificationChannel;
      data?: Record<string, unknown>;
    };
    const user = await this.prisma.user.findUnique({ where: { id: userId } });
    if (!user) return;

    if (channel === NotificationChannel.SMS && user.phone) {
      await this.sms.send(user.phone, `${title}: ${body}`);
    } else if (channel === NotificationChannel.EMAIL && user.email) {
      await this.email.send(user.email, title, `<p>${body}</p>`);
    }
    this.logger.debug(`Delivered ${channel} to ${userId}: ${title}`);
  }
}
