const listInclude = {
  category: { select: { id: true, name: true, slug: true } },
  vendor: { select: { id: true, storeName: true, slug: true, logoUrl: true } },
  variants: {
    select: {
      id: true, sku: true, name: true, priceCents: true, compareAtCents: true, imageUrl: true, optionValues: true,
      inventory: { select: { quantity: true, reservedQty: true } },
    },
  },
} satisfies Prisma.ProductInclude;

const detailInclude = {
  ...listInclude,
  reviews: {
    where: { isApproved: true },
    orderBy: { createdAt: 'desc' as const },
    take: 5,
    select: {
      id: true, rating: true, title: true, body: true, images: true, isVerified: true, helpfulCount: true, createdAt: true,
      user: { select: { id: true, fullName: true, avatarUrl: true } },
    },
  },
} satisfies Prisma.ProductInclude;

@Injectable()
export class ProductsService {
  private readonly logger = new Logger(ProductsService.name);

  constructor(
    private readonly prisma: PrismaService,
    private readonly search: SearchService,
  ) {}

  private availableQty(inv?: { quantity: number; reservedQty: number } | null) {
    if (!inv) return 0;
    return Math.max(0, inv.quantity - inv.reservedQty);
  }

  private serialize(p: any) {
    const variants = (p.variants ?? []).map((v: any) => ({
      ...v,
      available: this.availableQty(v.inventory),
      inventory: undefined,
    }));
    const totalAvailable = variants.reduce((sum: number, v: any) => sum + v.available, 0);
    return { ...p, variants, totalAvailable };
  }

  async list(query: ListProductsQueryDto) {
    const page = query.page ?? 1;
    const perPage = Math.min(query.perPage ?? 24, 60);
    const where: Prisma.ProductWhereInput = {};

    // public listing → only ACTIVE; admin/vendor requests pass explicit status
    where.status = query.status ?? ProductStatus.ACTIVE;
    if (query.categoryId) where.categoryId = query.categoryId;
    if (query.categorySlug) where.category = { slug: query.categorySlug };
    if (query.vendorId) where.vendorId = query.vendorId;
    if (query.brand) where.brand = query.brand;
    if (query.minRating !== undefined) where.ratingAvg = { gte: query.minRating };
    if (query.minPriceCents !== undefined || query.maxPriceCents !== undefined) {
      where.basePriceCents = {};
      if (query.minPriceCents !== undefined) (where.basePriceCents as any).gte = query.minPriceCents;
      if (query.maxPriceCents !== undefined) (where.basePriceCents as any).lte = query.maxPriceCents;
    }
    if (query.q && query.q.trim()) {
      where.OR = [
        { name: { contains: query.q, mode: 'insensitive' } },
        { brand: { contains: query.q, mode: 'insensitive' } },
      ];
    }

    const orderBy: Prisma.ProductOrderByWithRelationInput =
      query.sort === 'price_asc' ? { basePriceCents: 'asc' }
      : query.sort === 'price_desc' ? { basePriceCents: 'desc' }
      : query.sort === 'rating' ? { ratingAvg: 'desc' }
      : query.sort === 'popular' ? { soldCount: 'desc' }
      : { createdAt: 'desc' };

    const [rows, total] = await Promise.all([
      this.prisma.product.findMany({
        where, orderBy, include: listInclude,
        skip: (page - 1) * perPage, take: perPage,
      }),
      this.prisma.product.count({ where }),
    ]);

    return paginated(rows.map((r) => this.serialize(r)), total, page, perPage);
  }

  async findById(id: string) {
    const p = await this.prisma.product.findUnique({ where: { id }, include: detailInclude });
    if (!p) throw new HttpException({ code: ErrorCode.PRODUCT_NOT_FOUND, message: 'Product not found' }, HttpStatus.NOT_FOUND);
    return this.serialize(p);
  }

  async findBySlug(slug: string) {
    const p = await this.prisma.product.findUnique({ where: { slug }, include: detailInclude });
    if (!p || p.status !== ProductStatus.ACTIVE) {
      throw new HttpException({ code: ErrorCode.PRODUCT_NOT_FOUND, message: 'Product not found' }, HttpStatus.NOT_FOUND);
    }
    return this.serialize(p);
  }

  async create(vendorId: string, dto: CreateProductDto) {
    if (!dto.variants || dto.variants.length === 0) {
      throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'At least one variant required' }, HttpStatus.BAD_REQUEST);
    }
    const cat = await this.prisma.category.findUnique({ where: { id: dto.categoryId } });
    if (!cat) throw new HttpException({ code: ErrorCode.VALIDATION_ERROR, message: 'Invalid category' }, HttpStatus.BAD_REQUEST);

    const baseSlug = dto.slug ?? slugify(dto.name, { lower: true, strict: true });
    let slug = baseSlug;
    let i = 1;
    while (await this.prisma.product.findUnique({ where: { slug } })) slug = `${baseSlug}-${++i}`;

    const created = await this.prisma.product.create({
      data: {
        vendorId,
        categoryId: dto.categoryId,
        slug,
        name: dto.name,
        description: dto.description,
        brand: dto.brand,
        images: dto.images as any,
        basePriceCents: dto.basePriceCents,
        compareAtCents: dto.compareAtCents,
        status: (dto.status ?? 'DRAFT') as ProductStatus,
        isFeatured: dto.isFeatured ?? false,
        attributes: (dto.attributes ?? {}) as any,
        metaTitle: dto.metaTitle,
        metaDescription: dto.metaDescription,
        publishedAt: dto.status === 'ACTIVE' ? new Date() : null,
        variants: {
          create: dto.variants.map((v) => ({
            sku: v.sku,
            name: v.name,
            imageUrl: v.imageUrl,
            priceCents: v.priceCents,
            compareAtCents: v.compareAtCents,
            optionValues: (v.attributes ?? {}) as any,
            inventory: { create: { quantity: v.quantity ?? 0 } },
          })),
        },
      },
      include: listInclude,
    });

    if (created.status === ProductStatus.ACTIVE) {
      this.search.indexProduct(created.id).catch((e) => this.logger.warn(`Index failed: ${e.message}`));
    }
    return this.serialize(created);
  }

  async update(vendorId: string, productId: string, dto: UpdateProductDto, isAdmin = false) {
    const existing = await this.prisma.product.findUnique({ where: { id: productId } });
    if (!existing) throw new HttpException({ code: ErrorCode.PRODUCT_NOT_FOUND, message: 'Product not found' }, HttpStatus.NOT_FOUND);
    if (!isAdmin && existing.vendorId !== vendorId) {
      throw new HttpException({ code: ErrorCode.AUTH_FORBIDDEN, message: 'Not your product' }, HttpStatus.FORBIDDEN);
    }
    const updated = await this.prisma.product.update({
      where: { id: productId },
      data: {
        name: dto.name,
        slug: dto.slug,
        description: dto.description,
        categoryId: dto.categoryId,
        brand: dto.brand,
        images: dto.images as any,
        basePriceCents: dto.basePriceCents,
        compareAtCents: dto.compareAtCents,
        status: dto.status as ProductStatus | undefined,
        isFeatured: dto.isFeatured,
        attributes: dto.attributes as any,
        metaTitle: dto.metaTitle,
        metaDescription: dto.metaDescription,
        publishedAt: dto.status === 'ACTIVE' && !existing.publishedAt ? new Date() : existing.publishedAt,
      },
      include: listInclude,
    });
    if (updated.status === ProductStatus.ACTIVE) {
      this.search.indexProduct(updated.id).catch((e) => this.logger.warn(`Index failed: ${e.message}`));
    } else {
      this.search.removeProduct(updated.id).catch(() => undefined);
    }
    return this.serialize(updated);
  }

  async remove(vendorId: string, productId: string, isAdmin = false) {
    const existing = await this.prisma.product.findUnique({ where: { id: productId } });
    if (!existing) throw new HttpException({ code: ErrorCode.PRODUCT_NOT_FOUND, message: 'Product not found' }, HttpStatus.NOT_FOUND);
    if (!isAdmin && existing.vendorId !== vendorId) {
      throw new HttpException({ code: ErrorCode.AUTH_FORBIDDEN, message: 'Not your product' }, HttpStatus.FORBIDDEN);
    }
    await this.prisma.product.update({ where: { id: productId }, data: { status: ProductStatus.ARCHIVED } });
    await this.search.removeProduct(productId).catch(() => undefined);
    return { message: 'Archived' };
  }
}
